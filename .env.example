# ---------- Supabase ----------
PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server-only, never expose

# ---------- Mollie ----------
MOLLIE_API_KEY="test_xxxx"                          # test_ or live_

# ---------- Site ----------
# Productie: https://villahapp.nl. Canonical, sitemap, robots, og-tags en de
# noindex-guard volgen automatisch (src/lib/site.ts).
# Op *.vercel.app blijft de site bewust op noindex staan.
PUBLIC_SITE_URL="http://localhost:4321"             # ook voor redirect/webhook URLs

# ---------- Mail (optioneel, orderbevestiging via Resend) ----------
# Zonder RESEND_API_KEY wordt er bewust geen mail verstuurd.
RESEND_API_KEY=""                                   # begint met re_
# Het domein achter dit adres moet in Resend geverifieerd zijn, anders weigert
# Resend elke verzending. Astro bakt deze waarde bij de build in, dus na een
# wijziging in Vercel is een redeploy nodig.
MAIL_FROM="Villa Happ <contact@villahapp.nl>"

# ---------- Beheer ----------
# CRON_SECRET: beveiligt /api/notify/run (back-in-stock-verzender).
# Vercel stuurt dit automatisch mee als Authorization-header bij cron-runs.
CRON_SECRET=""
# ---------- Beheerportaal (/beheer) ----------
# AUTH_SECRET tekent de beheersessie en de volglinks in de klantmails.
# Minimaal 32 tekens. Roteren maakt bestaande volglinks ongeldig.
AUTH_SECRET=""
# Wachtwoordhash voor /beheer. Genereer met:  npm run beheer:hash -- 'wachtwoord'
# Let op: het formaat gebruikt dubbele punten, geen $. Een $ in een .env-waarde
# wordt als variabele gelezen en sloopt de salt.
ADMIN_PASSWORD_HASH=""

# ---------- Meting (optioneel) ----------
# GTM-containerid, bv. GTM-XXXXXXX. Zonder deze laadt er geen GTM, geen
# GA4, geen Ads en geen cookiebanner — en zegt /cookies dat er niets te
# kiezen valt. Zie docs/meetplan.md.
# Zet hem in Vercel alleen op Production; previews horen niet mee te tellen.
PUBLIC_GTM_ID=""
