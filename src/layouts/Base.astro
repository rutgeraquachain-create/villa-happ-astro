---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import CartDrawer from '../components/commerce/CartDrawer.astro';
import ConsentBanner from '../components/layout/ConsentBanner.astro';
import { isPreviewHost } from '../lib/site';
import { srcsetFor, optimizedSrc } from '../lib/img';
import { organizationLd, websiteLd, BRAND } from '../lib/entity';
import Analytics from '@vercel/analytics/astro';

// Self-hosted fonts (geen Google Fonts CDN: sneller, geen third-party, AVG-proof)
import '@fontsource-variable/inter/index.css';
import '@fontsource-variable/fraunces/standard.css';
import '@fontsource-variable/fraunces/standard-italic.css';
import '@fontsource/space-mono/index.css';

import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/buttons.css';

/** Het sitebrede deelbeeld. Afmetingen hieronder horen bij dít bestand. */
const DEFAULT_OG_IMAGE = '/img/og/villa-happ-og.webp';
const DEFAULT_OG_SIZE = { width: 1200, height: 628 };

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Alt-tekst bij het deelbeeld. Beschrijf wat er te zien is, niet het merk. */
  ogImageAlt?: string;
  bodyClass?: string;
  showHeader?: boolean;
  showFooter?: boolean;
  noindex?: boolean;
  /**
   * Geen enkele meting op deze pagina: geen GTM, geen Vercel Analytics, geen
   * paginaweergave. Voor pagina's waar het PAD zelf een sleutel is.
   *
   * GEMETEN 12 SEPTEMBER 2026, UIT EEN EXTERNE AUDIT. `/bestelling/<token>`
   * zette keurig `no-store` en `noindex` omdat de pagina persoonsgegevens
   * toont, en gaf vervolgens via de gewone layout `location.pathname` door aan
   * de dataLayer. Dat pad is een capability-token met 120 dagen geldigheid. Het
   * ging dus als gewone paginaweergave naar Google en naar Vercel Analytics.
   *
   * Deze vlag is bewust grof. Een veld anonimiseren dekt de automatische
   * paginaweergaves van de leveranciers niet, en op zo'n pagina is er niets te
   * meten dat opweegt tegen het risico.
   */
  privaat?: boolean;
  /** LCP-beeld van deze pagina; wordt responsive gepreload */
  preloadImage?: string;
}

const {
  title = 'Villa Happ · Heritage lifestyle, gemaakt voor nu',
  description = 'Nederlands lifestylelabel sinds 1945, ontstaan in Tilburg en gevestigd in Waalwijk. Van familieverhaal naar mode-erfgoed, met limited edition drops.',
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt,
  bodyClass = '',
  showHeader = true,
  showFooter = true,
  noindex = false,
  privaat = false,
  preloadImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
// Social platforms vereisen een absolute og:image-URL
const ogImageAbs = new URL(ogImage, canonicalURL).toString();
/**
 * Afmetingen alleen meegeven bij het sitebrede deelbeeld. PDP's en journal
 * sturen hun eigen beeld mee met een andere verhouding; een hardgecodeerde
 * 1200x628 zou daar een leugen zijn en levert een verkeerd bijgesneden preview.
 */
const ogSize = ogImage === DEFAULT_OG_IMAGE ? DEFAULT_OG_SIZE : null;
const ogAlt = ogImageAlt
  ?? (ogImage === DEFAULT_OG_IMAGE
    ? BRAND.shareImageAlt
    : title);
// Preview-omgeving (*.vercel.app) mag nooit de index in
const preview = isPreviewHost(canonicalURL.origin);

/**
 * GTM-container. Zonder PUBLIC_GTM_ID laadt er niets: geen script, geen
 * noscript-iframe, geen consentbanner. Zo kan de meetopstelling in de code
 * staan voordat de container bestaat, zonder dat er een banner verschijnt
 * voor cookies die niemand zet.
 *
 * Op previews bewust uit: die zouden anders meetellen in de rapportage.
 */
const gtmId = (!preview && !privaat) ? (import.meta.env.PUBLIC_GTM_ID || '') : '';
---

<!doctype html>
<html lang="nl" class="no-js">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {/* Villa Happ Vh-monogram. De Astro-favicon.svg is weg: browsers geven
      voorrang aan SVG, dus die won van de .ico en toonde het Astro-logo. */}
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {preloadImage && (
    <link
      rel="preload"
      as="image"
      href={optimizedSrc(preloadImage, 1080)}
      imagesrcset={srcsetFor(preloadImage)}
      imagesizes="100vw"
      fetchpriority="high"
    />
  )}
  <script is:inline>document.documentElement.classList.remove('no-js');</script>

  {/**
    * Het ordertoken uit de zichtbare URL halen, vóór welk meetscript dan ook.
    *
    * GEMETEN 12 SEPTEMBER 2026, UIT EEN EXTERNE AUDIT.
    * `/checkout/success?t=<token>` draagt een ondertekend capability-token in de
    * query. GTM geeft `{{Page URL}}` door als `page_location`, dus dat token
    * belandde bij Google, in de browsergeschiedenis en in elke referrer die de
    * pagina uitstuurt. Een token is geen identificatie maar een sleutel: wie hem
    * heeft, ziet naam, adres en bestelling.
    *
    * Dit script staat bewust boven het GTM-blok hieronder. Het haalt `t` weg en
    * legt hem in `window.__vhOrderToken`, zodat de bedanktpagina hem nog kan
    * gebruiken om de status op te halen. De pagina zelf merkt er niets van; de
    * adresbalk toont daarna een schone URL.
    *
    * De portaalpagina `/bestelling/<token>` draagt hem in het PAD en is daarmee
    * niet te schonen zonder de pagina te breken. Die krijgt daarom `privaat` en
    * laadt helemaal geen meting. Zie de Props hierboven.
    */}
  <script is:inline>
    (function () {
      try {
        var u = new URL(location.href);
        var t = u.searchParams.get('t');
        if (!t) return;
        window.__vhOrderToken = t;
        u.searchParams.delete('t');
        history.replaceState(history.state, '', u.pathname + u.search + u.hash);
      } catch (e) { /* oude browser: liever de pagina laten werken */ }
    })();
  </script>

  {gtmId && (
    <>
      {/* Consent Mode v2 — MOET vóór het GTM-script staan. Laadt GTM eerder,
          dan meet Google één weergave lang met volledige opslag terwijl de
          bezoeker nog niets heeft gekozen. Alle vier de signalen beginnen op
          denied; src/lib/consent.ts doet daarna de update. */}
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        gtag('consent', 'default', {
          analytics_storage: 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          wait_for_update: 500,
        });
      </script>
      <script is:inline define:vars={{ gtmId }}>
        (function (w, d, s, i) {
          // Niet meten op een *.vercel.app-host. De pagina's zijn geprerenderd,
          // dus de servercode kan dit niet beslissen: één build wordt op elke
          // host hetzelfde geserveerd, en `isPreviewHost` kijkt naar het
          // ingestelde domein en niet naar de host van het verzoek. Zonder
          // deze controle telt elk bezoek aan de deploy-URL mee in GA4.
          if (/\.vercel\.app$/i.test(location.hostname)) return;
          w[ 'dataLayer' ] = w[ 'dataLayer' ] || [];
          w[ 'dataLayer' ].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0], j = d.createElement(s);
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', gtmId);
      </script>
    </>
  )}
  <script is:inline>
  // Diagnose: vangt de eerste JS-fout; met ?vh-debug in de URL verschijnt
  // een statusoverlay (build, reduce-motion, pins, scrollY, fouten).
  (function () {
    window.addEventListener('error', function (e) {
      if (!window.__vhErr) window.__vhErr = (e.message || 'script error') + ' @ ' + String(e.filename || '').split('/').pop() + ':' + e.lineno;
    });
    window.addEventListener('unhandledrejection', function (e) {
      if (!window.__vhErr) window.__vhErr = 'promise: ' + e.reason;
    });
    if (location.search.indexOf('vh-debug') === -1) return;
    function start() {
      var d = document.createElement('div');
      d.style.cssText = 'position:fixed;bottom:10px;left:10px;right:10px;z-index:99999;background:rgba(0,0,0,.85);color:#7CFC00;font:11px/1.6 monospace;padding:10px 12px;border-radius:8px;pointer-events:none;white-space:pre-wrap;';
      document.body.appendChild(d);
      setInterval(function () {
        var meta = document.querySelector('meta[name="vh-build"]');
        var red = matchMedia('(prefers-reduced-motion: reduce)').matches;
        d.textContent =
          'build ' + (meta ? meta.getAttribute('content') : '?') +
          ' | ' + innerWidth + 'x' + innerHeight +
          ' | scrollY ' + Math.round(scrollY) +
          '\nreduce-motion: ' + (red ? 'AAN, site staat bewust op statisch' : 'uit') +
          ' | pins: ' + document.querySelectorAll('.pin-spacer').length +
          ' | motion: ' + (window.__vhMotion ? 'gestart' : 'NIET GESTART') +
          '\nfout: ' + (window.__vhErr || 'geen');
      }, 400);
    }
    if (document.body) start(); else addEventListener('DOMContentLoaded', start);
  })();
  </script>

  <title>{title}</title>
  <meta name="description" content={description} />
  {(noindex || preview) && <meta name="robots" content="noindex, follow" />}
  <meta name="vh-build" content={(process.env.VERCEL_GIT_COMMIT_SHA || 'local').slice(0, 7)} />
  <link rel="canonical" href={canonicalURL.toString()} />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageAbs} />
  <meta property="og:image:alt" content={ogAlt} />
  {ogSize && (
    <>
      <meta property="og:image:width" content={String(ogSize.width)} />
      <meta property="og:image:height" content={String(ogSize.height)} />
    </>
  )}
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL.toString()} />
  <meta property="og:site_name" content="Villa Happ" />
  <meta property="og:locale" content="nl_NL" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbs} />
  <meta name="twitter:image:alt" content={ogAlt} />

  <meta name="theme-color" content="#F7F3EC" />

  <!-- SPA-navigatie met shared-element morph (productfoto grid → PDP) -->
  <ClientRouter />

  <!-- JSON-LD: Organization + WebSite (merkentiteit uit src/lib/entity.ts) -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationLd(canonicalURL.origin))}></script>
  <script type="application/ld+json" set:html={JSON.stringify(websiteLd(canonicalURL.origin))}></script>
</head>

<body class={`vh-body ${bodyClass}`}>
  {gtmId && (
    <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${gtmId}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />
  )}
  <a class="vh-skip-link" href="#main-content">Ga naar inhoud</a>

  {showHeader && (
    <div transition:persist="vh-header">
      <Header />
    </div>
  )}

  <main id="main-content">
    <slot />
  </main>

  {showFooter && <Footer />}

  <div transition:persist="vh-cartdrawer">
    <CartDrawer />
  </div>

  {/* Ook Vercel Analytics gaat uit op een privépagina: die legt het pad vast,
      en op /bestelling/<token> ís het pad de sleutel. */}
  {!privaat && <Analytics />}

  {gtmId && <ConsentBanner />}

  {gtmId && (
    <script>
      {/* De ClientRouter vervangt de DOM zonder pageload, dus GTM ziet geen
          nieuwe paginaweergave. Zonder dit meet je alleen de eerste pagina
          van een bezoek. */}
      import { trackPageView } from '../lib/analytics';
      import { onPageReady } from '../lib/page';
      onPageReady(() => { trackPageView(location.pathname, document.title); });
    </script>
  )}

  <script>
    // Homepage buiten de SPA-router houden: de GSAP/Lenis-motion daar
    // verwacht klassieke pageloads. Links naar én vanaf home worden dus
    // een volledige navigatie; de rest van de site swapt met morph.
    function markReloadLinks() {
      document.querySelectorAll('a[href="/"]').forEach((a) => a.setAttribute('data-astro-reload', ''));
      // Links naar zware GSAP/Lenis-pagina's: volledige navigatie i.p.v. swap.
      document.querySelectorAll('a[href="/het-atelier"]').forEach((a) => a.setAttribute('data-astro-reload', ''));
      // Op zulke pagina's zelf: alle uitgaande links ook volledig herladen,
      // zodat Lenis/ScrollTrigger nooit over een swap heen blijft hangen.
      if (document.body.classList.contains('vh-home') || document.body.classList.contains('vh-atelier')) {
        document.querySelectorAll('a[href^="/"]').forEach((a) => a.setAttribute('data-astro-reload', ''));
      }
    }
    document.addEventListener('astro:page-load', markReloadLinks);
    if (document.readyState !== 'loading') markReloadLinks();
    else document.addEventListener('DOMContentLoaded', markReloadLinks, { once: true });
  </script>

  <script>
    /**
     * BotID: de clienthelft. Hangt aan elk verzoek naar een pad uit
     * BOTID_PADEN een kenmerk dat de route daarna met `checkBotId()`
     * controleert.
     *
     * Bewust geen `onPageReady`: dit bindt niets aan de DOM en hoeft niet per
     * paginaweergave opnieuw. Onder de ClientRouter draait een module-script
     * één keer per sitebezoek, en dat is precies wat hier moet.
     *
     * De lijst staat in src/lib/botid-routes.ts, want de route en deze regel
     * zijn twee helften van dezelfde controle. Loopt er één uit de pas, dan
     * faalt `checkBotId()` en krijgt een echte bezoeker een 403.
     */
    import { initBotId } from 'botid/client/core';
    import { BOTID_PADEN } from '../lib/botid-routes';

    initBotId({ protect: BOTID_PADEN });
  </script>

  <script>
    /**
     * De ingang van het bezoek vastleggen, voordat de bezoeker doorklikt.
     *
     * Een module-script draait onder de ClientRouter één keer per volledige
     * pageload, en dat is precies het moment waarop de verwijzer en de
     * utm-velden nog kloppen. Zie src/lib/herkomst-client.ts voor waarom dit
     * zonder toestemming alleen in het geheugen blijft.
     */
    import { legIngangVast } from '../lib/herkomst-client';
    legIngangVast();
  </script>
</body>
</html>
