---
/**
 * GET /nieuwsbrief/bevestigen?t=<token>
 *
 * Stap twee van de dubbele opt-in. Deze pagina bevestigt níét bij het openen;
 * hij toont een knop die POST doet naar /api/newsletter/bevestigen.
 *
 * WAAROM DIE KNOP ERTUSSEN ZIT
 * Hier stond dat de link meteen bevestigde, met de afweging dat elke extra stap
 * bevestigingen kost. Gemeten 7 september 2026 bleek dat verkeerd uit te pakken:
 * van de negen bevestigde inschrijvingen kwam er geen enkele van een mens. Alle
 * negen kwamen van zakelijke domeinen met een mailscanner, zes ervan binnen een
 * minuut na verzending en één binnen drie seconden. De volledige meting staat in
 * src/pages/api/newsletter/bevestigen.ts.
 *
 * Zet dit niet terug naar bevestigen-bij-openen. Een scanner die klikt levert
 * een adres op dat als toestemming telt terwijl niemand toestemming gaf, en dat
 * merk je pas als er een mailing uit gaat.
 */
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { emailUitToken } from '../../lib/nieuwsbrief';

const token = Astro.url.searchParams.get('t');
// Alleen lezen, niets wijzigen. Dit bepaalt of we een knop tonen of een uitleg.
const email = emailUitToken(token, 'aanmelding');
---

<Base
  title="Aanmelding bevestigen · Villa Happ"
  description="Bevestig je aanmelding voor de Villa Happ nieuwsbrief."
  noindex={true}
>
  <section class="vh-page">
    <div class="vh-page-inner vh-smal">
      <header class="vh-page-head">
        <p class="vh-page-label vh-mono">Nieuwsbrief</p>
        <h1 class="vh-page-title" data-kop>
          {email ? 'Nog één klik.' : 'Deze link werkt niet meer.'}
        </h1>
      </header>

      {email ? (
        <div data-vraag>
          <p class="vh-lood">
            Klik op de knop en we zetten <b>{email}</b> op de lijst.
          </p>
          <p>
            Je hoort van ons als er een nieuwe oplage komt of als er iets te vertellen valt
            over het merk. Een paar keer per jaar, niet vaker. Onder elke mail staat een
            link om je weer uit te schrijven.
          </p>
          <form method="POST" action="/api/newsletter/bevestigen" class="vh-acties" data-form>
            <input type="hidden" name="t" value={token} />
            <button type="submit" class="vh-btn vh-btn--accent">
              <span data-knoplabel>Ja, meld me aan</span>
            </button>
          </form>
          <p class="vh-fout" role="alert" data-fout></p>
        </div>
      ) : (
        <>
          <p class="vh-lood">
            De link is verlopen of klopt niet. Bevestigingslinks zijn een week geldig.
          </p>
          <p>
            Meld je opnieuw aan onderaan een willekeurige pagina, dan sturen we een
            nieuwe bevestiging.
          </p>
        </>
      )}

      <div data-gelukt hidden>
        <p class="vh-lood" data-gelukttekst></p>
        <p>
          Je hoort van ons als er een nieuwe oplage komt of als er iets te vertellen valt
          over het merk. Onder elke mail staat een link om je weer uit te schrijven.
        </p>
      </div>

      <p class="vh-acties">
        <a href="/shop" class="vh-btn vh-btn--primary"><span>Bekijk de collectie</span></a>
      </p>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector('[data-form]') as HTMLFormElement | null;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const knop = form.querySelector('button') as HTMLButtonElement;
      const label = form.querySelector('[data-knoplabel]');
      const fout = document.querySelector('[data-fout]');
      knop.disabled = true;
      if (label) label.textContent = 'Een moment…';

      try {
        const res = await fetch('/api/newsletter/bevestigen', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ t: new FormData(form).get('t') }),
        });
        const data = await res.json();

        if (data.success) {
          const vraag = document.querySelector('[data-vraag]') as HTMLElement;
          const gelukt = document.querySelector('[data-gelukt]') as HTMLElement;
          const tekst = document.querySelector('[data-gelukttekst]');
          const kop = document.querySelector('[data-kop]');
          if (kop) kop.textContent = data.uitslag === 'al-actief' ? 'Je stond er al op.' : 'Je staat op de lijst.';
          if (tekst) {
            tekst.textContent = data.uitslag === 'al-actief'
              ? `${data.email} stond al op de lijst. Je hoeft verder niets te doen.`
              : `Bedankt. We hebben ${data.email} toegevoegd aan de lijst.`;
          }
          if (vraag) vraag.hidden = true;
          if (gelukt) gelukt.hidden = false;
          return;
        }

        if (fout) {
          fout.textContent = data.uitslag === 'ongeldig'
            ? 'Deze link is verlopen of klopt niet.'
            : 'Het lukte even niet. Probeer de link uit de mail over een paar minuten opnieuw.';
        }
        knop.disabled = false;
        if (label) label.textContent = 'Ja, meld me aan';
      } catch {
        if (fout) fout.textContent = 'Verbinding mislukt. Probeer het zo opnieuw.';
        knop.disabled = false;
        if (label) label.textContent = 'Ja, meld me aan';
      }
    });
  }
</script>

<style>
  .vh-smal { max-width: 620px; }
  .vh-lood { font-size: 18px; line-height: 1.65; }
  .vh-acties { margin-top: 32px; }
  .vh-fout { color: var(--vh-danger); font-size: 14px; min-height: 18px; margin-top: 12px; }
</style>
