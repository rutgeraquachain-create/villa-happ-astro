---
// Statisch gebouwd op deploy-moment: instant vanaf Vercel's CDN.
// (Zodra Supabase live data nodig is per request, schakel om naar ISR.)
export const prerender = true;

import Base from '../layouts/Base.astro';
import Loader from '../components/home/Loader.astro';
import Hero from '../components/home/Hero.astro';
import Marquee from '../components/home/Marquee.astro';
import Manifesto from '../components/home/Manifesto.astro';
import YearMask from '../components/home/YearMask.astro';
import HeritageScroll from '../components/home/HeritageScroll.astro';
import Campaign from '../components/home/Campaign.astro';
import DropSpotlight from '../components/home/DropSpotlight.astro';
import ParallaxColumns from '../components/home/ParallaxColumns.astro';
import ShopGrid from '../components/home/ShopGrid.astro';
import Lookbook from '../components/home/Lookbook.astro';
import KineticWordmark from '../components/home/KineticWordmark.astro';
import Brands from '../components/home/Brands.astro';
import Finale from '../components/home/Finale.astro';

import '../styles/home.css';
---

<Base bodyClass="vh-home" title="Villa Happ · Heritage lifestyle, gemaakt voor nu" preloadImage="/img/products/hoodie-olijfgroen-lifestyle.webp">
  {/**
    * DEZE VOLGORDE IS EEN KEUZE, GEEN TOEVAL.
    *
    * Aangepast op 25 augustus 2026 op verzoek van Rutger. De pagina opende
    * eerder met het manifest en het verhaal, en kwam pas laat bij de producten
    * uit. Nu staat de collectie meteen na het jaartalblok en schuift het
    * verhaal naar achteren.
    *
    * De genummerde labels in de secties lopen mee met deze volgorde, dus
    * `01 / De collectie` staat bovenaan en `04 / Het verhaal` verderop.
    * Verplaats je hier een sectie, pas dan ook het nummer in dat component
    * aan; anders leest de pagina van boven naar beneden als 04, 03, 01 en
    * oogt dat als een fout.
    *
    * De blokken zonder nummer horen bij hun buur en reizen mee.
    *
    * `ParallaxColumns` hoort bij DE COLLECTIE en moet daar direct achter
    * blijven staan. Bij de eerste herschikking is die naar het archief
    * verhuisd, op de redenering dat het archiefbeelden zijn. Dat klopte niet:
    * van de acht foto's in dat blok zijn er zeven van de caps en de hoodies en
    * maar één uit het archief. Het is de verticale galerij met "Stap voor stap"
    * die de collectie laat zien, dus koppel die niet los.
    *
    * Marquee hoort bij de hero, KineticWordmark is de aanloop naar de
    * merkenfamilie.
    */}
  <Loader />
  <Hero />
  <Marquee />
  <YearMask />
  <ShopGrid />
  <ParallaxColumns />
  <DropSpotlight />
  <Manifesto />
  <Campaign />
  <HeritageScroll />
  <Lookbook />
  <KineticWordmark />
  <Brands />
  <Finale />
</Base>

<script>
  document.body.setAttribute('data-page', 'home');
</script>

<script>
  import '../lib/motion';
  import '../lib/cart';
</script>
