---
export const prerender = true;

import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import { EDITION } from '../lib/atelier';
import '../styles/atelier.css';

const siteOrigin = Astro.site?.origin || Astro.url.origin;
const pageUrl = `${siteOrigin}/het-atelier`;

// CreativeWork-schema: dit is een merkervaring, geen artikel of product.
const ld = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: 'Het Atelier — van schets tot jouw nummer op de Back-Cap',
  headline: 'Het Atelier',
  description: 'Loop door hoe de Villa Happ Back-Cap ontstaat: van materiaal en geborduurd embleem tot jouw eigen nummer in de genummerde oplage van 500.',
  url: pageUrl,
  inLanguage: 'nl-NL',
  publisher: { '@id': `${siteOrigin}/#organization` },
};
---
<Base
  title="Het Atelier · Villa Happ"
  description="Loop door hoe de Villa Happ Back-Cap ontstaat: het materiaal, het geborduurde embleem en jouw eigen nummer in de genummerde oplage van 500."
  ogImage="/img/og/villa-happ-og.webp"
  bodyClass="vh-atelier"
>
  <div class="atl">
    <div class="atl-progress" aria-hidden="true"><span></span></div>

    <!-- Intro: de schets -->
    <section class="atl-intro">
      <span class="atl-frame-tag">Atelier · Waalwijk · sinds 1945</span>
      <h1 class="atl-intro-title">Het <em>Atelier</em></h1>
      <p class="atl-intro-sub">
        De Back-Cap begint met een schets in Waalwijk en eindigt met een nummer.
        Loop mee langs het materiaal, het borduursel en de oplage, en claim aan
        het eind jouw eigen plek in de vijfhonderd.
      </p>
      <span class="atl-scrollcue">Scrol om te beginnen</span>
    </section>

    <!-- Station 1: het materiaal -->
    <section class="atl-station" id="station-stof" data-station="stof">
      <div class="atl-visual-wrap">
        <div class="atl-visual">
          <span class="atl-frame-tag">Station 01 · Het materiaal</span>
          <div class="atl-weave">
            <Pic src="/img/products/back-cap-angle-v2.webp" alt="Close-up van de Villa Happ Back-Cap" width={900} height={1125} widths={[480, 768, 1080]} sizes="(max-width: 900px) 100vw, 46vw" loading="lazy" />
          </div>
          <div class="atl-loupe" aria-hidden="true"></div>
        </div>
      </div>
      <div class="atl-copy">
        <p class="atl-copy-num atl-reveal">Station 01</p>
        <h2 class="atl-reveal">Eén uitvoering, goed gemaakt</h2>
        <p class="atl-reveal">
          De Back-Cap komt in één klassieke uitvoering: grijs met zwart mesh.
          Geen seizoenskleuren, geen varianten die volgend jaar weer verdwijnen.
          Verstelbaar achter, zodat één maat echt één maat is.
        </p>
        <span class="atl-spec atl-reveal"><b>1</b> uitvoering · one size, verstelbaar</span>
      </div>
    </section>

    <!-- Station 2: het borduursel -->
    <section class="atl-station" id="station-borduursel" data-station="borduursel">
      <div class="atl-visual-wrap">
        <div class="atl-visual" style="background:var(--vh-paper-deep)">
          <span class="atl-frame-tag">Station 02 · Het borduursel</span>
          <div class="atl-stitch" aria-hidden="true">
            <svg viewBox="0 0 200 200" role="img" aria-label="Het geborduurde VH-embleem">
              <rect class="atl-stitch-draw" x="34" y="44" width="132" height="112" rx="10" pathLength="1"></rect>
              <text class="atl-stitch-mark" x="100" y="118" text-anchor="middle" style="opacity:0; font-family:var(--vh-font-serif); font-style:italic; font-size:58px; fill:var(--vh-ink);">VH</text>
            </svg>
          </div>
        </div>
      </div>
      <div class="atl-copy">
        <p class="atl-copy-num atl-reveal">Station 02</p>
        <h2 class="atl-reveal">Geborduurd, niet geprint</h2>
        <p class="atl-reveal">
          Een print barst na tien wasbeurten. Ons embleem wordt geborduurd, draad
          voor draad, en blijft. Dat kost meer tijd en meer garen, en dat is
          precies het punt: dit stuk gaat jaren mee.
        </p>
        <span class="atl-spec atl-reveal"><b>1945</b> · het jaar dat het begon</span>
      </div>
    </section>

    <!-- Station 3: de oplage -->
    <section class="atl-station" id="station-oplage" data-station="oplage">
      <div class="atl-visual-wrap">
        <div class="atl-visual" style="background:var(--vh-espresso);color:var(--vh-paper)">
          <span class="atl-frame-tag">Station 03 · De oplage</span>
          <div class="atl-edition">
            <div class="atl-edition-num" id="atl-edition-num" data-edition={EDITION} style="color:var(--vh-paper)">{EDITION}</div>
            <div class="atl-edition-bar" aria-hidden="true"><span></span></div>
            <p class="atl-edition-note" style="color:rgba(244,238,227,0.7)">stuks in deze oplage · genummerd</p>
          </div>
        </div>
      </div>
      <div class="atl-copy">
        <p class="atl-copy-num atl-reveal">Station 03</p>
        <h2 class="atl-reveal">Een vast aantal, en op is op</h2>
        <p class="atl-reveal">
          We maken vooraf een vast aantal en daarna stopt het. Geen overproductie,
          geen bijmaken. Elk exemplaar krijgt een eigen nummer en een certificaat
          van echtheid. Als deze {EDITION} op zijn, komen ze niet terug.
        </p>
        <span class="atl-spec atl-reveal"><b>{EDITION}</b> stuks · genummerd 1 tot {EDITION}</span>
      </div>
    </section>

    <!-- Finale: de ontwerpstudio -->
    <section class="atl-finale" id="atl-finale">
      <header class="atl-studio-head">
        <p class="vh-mono atl-studio-kicker">Station 04 · De ontwerpstudio</p>
        <h2>Claim <em>jouw nummer</em></h2>
        <p class="atl-studio-sub">
          Alles wat je zag komt hier samen. Bekijk de cap van alle kanten en
          claim jouw nummer in de oplage van {EDITION}.
        </p>
      </header>

      <div class="atl-studio">
        <!-- Mockup -->
        <div class="atl-studio-stage">
          <span class="atl-frame-tag" id="atl-mockup-tag">Cap · Grijs melange · Voorkant</span>
          <img
            id="atl-mockup"
            src="/img/atelier/cap-front.webp"
            alt="Ontwerp: cap · grijs melange, voorkant"
            width="896" height="1200" loading="lazy"
          />
        </div>

        <!-- Configurator -->
        <div class="atl-studio-controls" id="atl-config">
          <div class="atl-control" id="atl-angle-control">
            <span class="atl-control-label vh-mono">Bekijk van</span>
            <div class="atl-angles" role="group" aria-label="Kies een hoek">
              <button type="button" class="atl-angle-btn is-on" data-angle="front" aria-pressed="true">Voorkant</button>
              <button type="button" class="atl-angle-btn" data-angle="side" aria-pressed="false">Zijkant</button>
              <button type="button" class="atl-angle-btn" data-angle="back" aria-pressed="false">Achterkant</button>
            </div>
            <p class="atl-onesize" id="atl-onesize">Onze cap komt in één klassieke uitvoering: grijs met zwart mesh.</p>
          </div>

          <form class="atl-form" id="atl-form" novalidate>
            <input type="text" id="atl-name" name="name" placeholder="Je naam (optioneel)" autocomplete="name" maxlength="40" aria-label="Je naam (optioneel)" />
            <input type="email" id="atl-email" name="email" placeholder="jouw@email.nl" autocomplete="email" required aria-label="E-mailadres" />
            <button type="submit" class="vh-btn vh-btn--accent" id="atl-submit"><span>Claim mijn nummer</span></button>
            <p class="atl-form-msg" id="atl-msg" role="status" aria-live="polite"></p>
            <label class="atl-form-check">
              <input type="checkbox" id="atl-newsletter" name="newsletter" />
              <span>Houd me ook op de hoogte van nieuwe drops (optioneel)</span>
            </label>
            <p class="atl-form-note">
              We mailen je over deze oplage. Uitschrijven kan altijd.
              Zie de <a href="/privacy">privacyverklaring</a>.
            </p>
          </form>
        </div>
      </div>

      <!-- Certificaat (verschijnt na claim, vervangt de configurator) -->
      <div class="atl-result" id="atl-result" hidden>
        <div class="atl-cert" id="atl-cert">
          <div class="atl-cert-head">
            <div>
              <p class="atl-cert-kicker">Villa Happ · Waalwijk</p>
              <p class="atl-cert-title">Certificaat van echtheid</p>
            </div>
            <span class="atl-cert-seal">VH</span>
          </div>
          <img class="atl-cert-mockup" id="atl-cert-mockup" src="/img/atelier/cap-front.webp" alt="" width="928" height="1152" />
          <p class="atl-cert-number" id="atl-cert-number">—</p>
          <p class="atl-cert-meta" id="atl-cert-meta">Genummerde oplage</p>
          <p class="atl-cert-foot" id="atl-cert-foot">
            Dit stuk is voor jou gereserveerd. Je hoort als eerste wanneer de oplage live gaat.
          </p>
        </div>

        <div class="atl-finale-actions">
          <button type="button" class="vh-btn vh-btn--light" id="atl-save"><span>Bewaar je certificaat</span></button>
          <button type="button" class="vh-btn vh-btn--ghost" id="atl-share"><span>Deel</span></button>
          <button type="button" class="vh-btn vh-btn--ghost" id="atl-again"><span>Ontwerp opnieuw</span></button>
          <a href="/shop" class="vh-btn vh-btn--ghost" data-astro-reload><span>Naar de collectie</span></a>
        </div>
      </div>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(ld)} is:inline></script>
</Base>

<script>
  import { initAtelier } from '../lib/atelier-motion';
  import {
    formatEdition, EDITION, describePiece,
    assetName, resolveAngle, ANGLE_LABELS, type Angle,
  } from '../lib/atelier';
  import '../lib/cart';

  initAtelier();

  /* ---------- De ontwerpstudio ----------
     Alleen de cap: dat is het enige stuk dat in een genummerde oplage
     loopt. Er valt dus geen stuk en geen kleur te kiezen, alleen de hoek
     waaronder je hem bekijkt. */
  let angle: Angle = 'front';

  const mockup = document.getElementById('atl-mockup') as HTMLImageElement;
  const mockupTag = document.getElementById('atl-mockup-tag')!;

  /** Eén plek die het beeld en de hoekknoppen op de huidige keuze zet. */
  function syncMockup() {
    angle = resolveAngle(angle);
    const piece = describePiece();
    const view = ANGLE_LABELS[angle];

    if (mockup) {
      mockup.src = `/img/atelier/${assetName(angle)}.webp`;
      mockup.alt = `Ontwerp: ${piece.toLowerCase()}, ${view.toLowerCase()}`;
    }
    mockupTag.textContent = `${piece} · ${view}`;

    document.querySelectorAll<HTMLButtonElement>('.atl-angle-btn').forEach((b) => {
      const on = b.dataset.angle === angle;
      b.classList.toggle('is-on', on);
      b.setAttribute('aria-pressed', String(on));
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.atl-angle-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      angle = resolveAngle(btn.dataset.angle);
      syncMockup(); // zet zelf de is-on/aria-pressed-status
    });
  });

  // De HTML rendert de startstaat al; dit houdt hem gegarandeerd in sync
  syncMockup();

  /* ---------- Claim + certificaat ---------- */
  const form = document.getElementById('atl-form') as HTMLFormElement;
  const emailEl = document.getElementById('atl-email') as HTMLInputElement;
  const nameEl = document.getElementById('atl-name') as HTMLInputElement;
  const submitBtn = document.getElementById('atl-submit') as HTMLButtonElement;
  const msg = document.getElementById('atl-msg')!;
  const config = document.getElementById('atl-config')!;
  const result = document.getElementById('atl-result')!;
  const certNumber = document.getElementById('atl-cert-number')!;
  const certMeta = document.getElementById('atl-cert-meta')!;
  const certFoot = document.getElementById('atl-cert-foot')!;
  const certMockup = document.getElementById('atl-cert-mockup') as HTMLImageElement;

  const KEY = 'vh_atelier_claim';
  const fmtDate = () => new Date().toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });

  // Fallback-nummer zonder database: stabiel afgeleid uit het e-mailadres.
  function localNumber(email: string): number {
    let h = 0;
    for (let i = 0; i < email.length; i++) h = (h * 31 + email.charCodeAt(i)) >>> 0;
    return (h % EDITION) + 1;
  }

  interface Claim { number: number; edition: number; name: string; angle: string; date: string; }

  const claimAsset = (c: Claim) => `/img/atelier/${assetName(c.angle)}.webp`;

  function showResult(c: Claim) {
    config.setAttribute('hidden', '');
    result.removeAttribute('hidden');
    certNumber.textContent = formatEdition(c.number, c.edition);
    certMeta.textContent = `${c.name ? c.name + ' · ' : ''}${describePiece()} · ${c.date}`;
    // Geen "gereserveerd": er wordt geen voorraad vastgehouden. Wat we wel
    // waarmaken is dat dit nummer aan dit e-mailadres verbonden blijft.
    certFoot.textContent = 'Dit nummer staat op jouw naam. Je hoort als eerste wanneer de oplage live gaat.';
    certMockup.src = claimAsset(c);
    certMockup.alt = describePiece();
  }

  /** Terug naar de configurator zonder de claim weg te gooien. */
  function showConfigurator() {
    result.setAttribute('hidden', '');
    config.removeAttribute('hidden');
    syncMockup();
    config.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  // Al eerder geclaimd in deze browser? Toon meteen het resultaat, maar laat
  // wel de weg terug open: eerder verdween de studio hier voorgoed.
  try {
    const saved = JSON.parse(localStorage.getItem(KEY) || 'null');
    if (saved && saved.number) {
      angle = resolveAngle(saved.angle);
      showResult(saved);
    }
  } catch {}

  document.getElementById('atl-again')?.addEventListener('click', showConfigurator);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = emailEl.value.trim();
    if (!/.+@.+\..+/.test(email)) { msg.textContent = 'Vul een geldig e-mailadres in.'; msg.classList.add('is-error'); emailEl.focus(); return; }
    msg.classList.remove('is-error');
    msg.textContent = '';
    submitBtn.disabled = true;
    submitBtn.querySelector('span')!.textContent = 'Een moment…';

    const name = nameEl.value.trim();
    let number = 0, edition = EDITION;
    try {
      const res = await fetch('/api/atelier/claim', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email,
          name: name || undefined,
          garment: 'cap',
          // Inschrijven op de nieuwsbrief alleen als er expliciet is
          // aangevinkt; eerder gebeurde dat stilzwijgend bij elke claim.
          newsletter: (document.getElementById('atl-newsletter') as HTMLInputElement)?.checked === true,
        }),
      });
      if (res.ok) {
        const data = await res.json();
        number = data.number; edition = data.edition || EDITION;
      } else if (res.status === 429) {
        msg.textContent = 'Even rustig aan. Probeer het zo opnieuw.'; msg.classList.add('is-error');
        submitBtn.disabled = false; submitBtn.querySelector('span')!.textContent = 'Claim mijn nummer'; return;
      } else {
        number = localNumber(email); // 503/demo: lokaal nummer
      }
    } catch {
      number = localNumber(email);
    }

    const claim: Claim = { number, edition, name, angle, date: fmtDate() };
    try { localStorage.setItem(KEY, JSON.stringify(claim)); } catch {}
    showResult(claim);
    window.dispatchEvent(new CustomEvent('vh:toast', { detail: `Nummer ${formatEdition(number, edition)} is van jou ✦` }));
  });

  function currentClaim(): Claim | null {
    try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch { return null; }
  }

  function loadImage(src: string): Promise<HTMLImageElement> {
    return new Promise((resolve, reject) => {
      const im = new Image(); im.crossOrigin = 'anonymous';
      im.onload = () => resolve(im); im.onerror = reject; im.src = src;
    });
  }

  /* Certificaat als deelbare afbeelding (canvas, self-contained) */
  async function renderCanvas(c: Claim): Promise<HTMLCanvasElement> {
    const S = 2;
    const w = 440, h = 560;
    const cv = document.createElement('canvas');
    cv.width = w * S; cv.height = h * S;
    const ctx = cv.getContext('2d')!;
    ctx.scale(S, S);
    try { await (document as any).fonts.ready; } catch {}
    // achtergrond
    ctx.fillStyle = '#F4EEE3'; ctx.fillRect(0, 0, w, h);
    ctx.strokeStyle = 'rgba(28,24,19,0.18)'; ctx.setLineDash([4, 4]); ctx.strokeRect(12, 12, w - 24, h - 24); ctx.setLineDash([]);
    // mockup
    try {
      const im = await loadImage(claimAsset(c));
      const iw = 240, ih = iw * (im.height / im.width);
      ctx.drawImage(im, (w - iw) / 2, 40, iw, ih);
    } catch {}
    // koppen
    ctx.textAlign = 'left';
    ctx.fillStyle = 'rgba(28,24,19,0.6)'; ctx.font = '10px "Space Mono", monospace';
    ctx.fillText('VILLA HAPP · WAALWIJK', 34, 380);
    ctx.fillStyle = '#1C1813'; ctx.font = '22px "Fraunces Variable", Georgia, serif';
    ctx.fillText('Certificaat van echtheid', 34, 406);
    // nummer
    ctx.font = '58px "Fraunces Variable", Georgia, serif';
    ctx.fillText(formatEdition(c.number, c.edition), 32, 470);
    // VH-zegel
    ctx.strokeStyle = '#1C1813'; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.arc(w - 62, 438, 26, 0, Math.PI * 2); ctx.stroke();
    ctx.fillStyle = '#1C1813'; ctx.textAlign = 'center'; ctx.font = 'italic 18px "Fraunces Variable", Georgia, serif';
    ctx.fillText('VH', w - 62, 445);
    // meta
    ctx.textAlign = 'left'; ctx.fillStyle = 'rgba(28,24,19,0.6)'; ctx.font = '11px "Space Mono", monospace';
    ctx.fillText(`${(c.name ? c.name.toUpperCase() + ' · ' : '')}${describePiece().toUpperCase()}`, 34, 496);
    // voet
    ctx.strokeStyle = 'rgba(28,24,19,0.12)'; ctx.beginPath(); ctx.moveTo(34, 520); ctx.lineTo(w - 34, 520); ctx.stroke();
    ctx.fillStyle = 'rgba(28,24,19,0.6)'; ctx.font = '12px "Fraunces Variable", Georgia, serif';
    ctx.fillText('Genummerd · ontworpen in Waalwijk · komt niet terug', 34, 542);
    return cv;
  }

  document.getElementById('atl-save')?.addEventListener('click', async () => {
    const c = currentClaim(); if (!c) return;
    const cv = await renderCanvas(c);
    const a = document.createElement('a');
    a.href = cv.toDataURL('image/png');
    a.download = `villa-happ-nummer-${String(c.number).padStart(3, '0')}.png`;
    a.click();
  });

  document.getElementById('atl-share')?.addEventListener('click', async () => {
    const c = currentClaim(); if (!c) return;
    const text = `Ik claimde nummer ${formatEdition(c.number, c.edition)} van de Villa Happ Back-Cap.`;
    const url = `${location.origin}/het-atelier`;
    if ((navigator as any).share) {
      try { await (navigator as any).share({ title: 'Villa Happ · Het Atelier', text, url }); return; } catch {}
    }
    try {
      await navigator.clipboard.writeText(`${text} ${url}`);
      window.dispatchEvent(new CustomEvent('vh:toast', { detail: 'Link gekopieerd ✦' }));
    } catch {}
  });
</script>
