---
export const prerender = true;

import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import { BUSINESS } from '../lib/business';
import { BRAND } from '../lib/entity';
import { persOpDatum } from '../lib/pers-archief';
import '../styles/shop.css';

/**
 * Perspagina. Stond al in de footer maar bestond niet (404 op elke pagina).
 * De feiten komen uit entity.ts, dezelfde bron als het schema en llms.txt,
 * zodat een journalist en een AI-crawler exact hetzelfde lezen.
 */

const facts = [
  { k: 'Opgericht', v: '1945, Tilburg' },
  { k: 'Oorspronkelijke naam', v: 'Gaillard Kuijsters (1945), vanaf midden jaren vijftig Babyparadijs' },
  { k: 'Oprichters', v: 'Tony Kuijsters en Noud van Happen' },
  { k: 'Eerste winkel', v: 'Heuvelstraat 85, Tilburg' },
  { k: 'Merkrechten terug in de familie', v: '2021, door Rutger van Happen' },
  { k: 'Heropstart', v: '2026, door Rutger van Happen (derde generatie)' },
  { k: 'Vestigingsplaats', v: `${BUSINESS.businessAddress.street}, ${BUSINESS.businessAddress.postalCode} ${BUSINESS.businessAddress.city}` },
  { k: 'Hoogtepunt', v: '80 winkels door Europa' },
  { k: 'Nu', v: 'Heritage lifestylelabel; caps in genummerde oplage' },
];

const assets = [
  { src: '/img/brand/villa-happ-logo.webp', label: 'Beeldmerk', note: 'PNG/WebP, transparant' },
  { src: '/img/products/hoodie-olijfgroen-lifestyle.webp', label: 'Campagnebeeld', note: 'Organic Cotton Hoodie' },
  { src: '/img/heritage/origin-babyparadijs.webp', label: 'Archief', note: 'Babyparadijs, Tilburg' },
];
---
<Base
  title="Pers · Villa Happ"
  description="Persinformatie over Villa Happ: het verhaal in het kort, de kernfeiten, beeldmateriaal en contactgegevens voor media."
>
  <section class="vh-page">
    <div class="vh-page-inner">
      <header class="vh-page-head">
        <p class="vh-page-label vh-mono">Voor media</p>
        <h1 class="vh-page-title">Pers &amp; <span class="vh-italic-accent">perskit</span></h1>
        <p class="vh-page-sub">
          Schrijf je over Villa Happ? Hieronder staan de feiten die kloppen, het
          verhaal in één alinea en beeldmateriaal dat je mag gebruiken.
        </p>
      </header>

      <div class="vh-trust">
        <div class="vh-trust-group">
          <h2 class="vh-trust-group-title">Het merk in één alinea</h2>
          <p class="vh-prose">{BRAND.definition}</p>
        </div>

        {/* De definitie erboven is bedoeld om letterlijk te citeren; dit is
            dezelfde inhoud als lopend verhaal, voor wie een langere tekst
            nodig heeft. Eén bron in entity.ts, zodat de twee niet uit de
            pas gaan lopen. */}
        <div class="vh-trust-group">
          <h2 class="vh-trust-group-title">Het merk in het verhaal</h2>
          {BRAND.narrative.map((p) => <p class="vh-prose">{p}</p>)}
        </div>

        <div class="vh-trust-group">
          <h2 class="vh-trust-group-title">Kernfeiten</h2>
          <div class="vh-legal-tablewrap">
            <table class="vh-legal-table">
              <tbody>
                {facts.map((f) => (
                  <tr><td style="width:36%"><b>{f.k}</b></td><td>{f.v}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div class="vh-trust-group">
          <h2 class="vh-trust-group-title">De geschiedenis, kort</h2>
          <ul class="vh-prose-list">
            {BRAND.facts.map((f) => <li>{f}</li>)}
          </ul>
          <p class="vh-prose" style="margin-top:14px;">
            Het volledige verhaal in zeven hoofdstukken staat op
            <a href="/story">de verhaalpagina</a>.
          </p>
        </div>

        {/**
          * Archief van vermeldingen in de vakpers. Geen citaten uit de stukken
          * en geen screenshots: alleen kop, uitgever, datum en een link naar
          * het origineel. Zo blijft het bij verwijzen, en leest de bezoeker het
          * artikel bij de bron die het geschreven heeft.
          *
          * Dit is ook de onderbouwing van de bijnaam die op /story staat. Een
          * merk dat over zichzelf zegt dat de pers hem The Comeback Kid noemde,
          * hoort te kunnen laten zien waar dat staat.
          */}
        <div class="vh-trust-group">
          <h2 class="vh-trust-group-title">Villa Happ in de pers</h2>
          <p class="vh-prose" style="margin-bottom:18px;">
            De opkomst en de val zijn destijds door de vakpers gevolgd. Deze
            stukken zijn van de betreffende redacties, niet van ons; ze staan
            hier als vindplaats. De bijnaam The Comeback Kid komt uit het
            artikel van FashionUnited van 1 juni 2007.
          </p>
          <ol class="vh-pers-lijst" role="list">
            {persOpDatum().map((p) => (
              <li class="vh-pers-item">
                <a href={p.url} target="_blank" rel="noopener noreferrer">{p.kop}</a>
                <span class="vh-pers-meta vh-mono">
                  {p.bron}<span aria-hidden="true"> · </span>
                  <time datetime={p.datum}>{p.datumTekst}</time>
                </span>
              </li>
            ))}
          </ol>
        </div>

        <div class="vh-trust-group">
          <h2 class="vh-trust-group-title">Beeldmateriaal</h2>
          <p class="vh-prose" style="margin-bottom:18px;">
            Vrij te gebruiken bij redactionele berichtgeving over Villa Happ,
            met bronvermelding &ldquo;Villa Happ&rdquo;. Klik om het bestand op
            volledig formaat te openen.
          </p>
          <div class="vh-press-grid">
            {assets.map((a) => (
              <figure class="vh-press-item">
                <a href={a.src} target="_blank" rel="noopener">
                  <Pic src={a.src} alt={a.label} width={480} height={480} widths={[320, 480]} sizes="(max-width: 700px) 45vw, 220px" loading="lazy" />
                </a>
                <figcaption>
                  <b>{a.label}</b><br />
                  <span class="vh-mono">{a.note}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>

        <div class="vh-trust-group">
          <h2 class="vh-trust-group-title">Perscontact</h2>
          <p class="vh-prose">
            Vragen, interviewverzoeken of aanvullend beeld?<br />
            <a href={`mailto:${BUSINESS.supportEmail}`}>{BUSINESS.supportEmail}</a><br />
            {BUSINESS.legalName} · KvK {BUSINESS.kvk}
          </p>
        </div>
      </div>
    </div>
  </section>

  <style>
    .vh-press-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 22px;
      max-width: 760px;
    }
    .vh-press-item { margin: 0; }
    .vh-press-item img {
      width: 100%;
      height: auto;
      aspect-ratio: 1;
      object-fit: cover;
      background: var(--vh-paper-soft);
      border: 1px solid var(--vh-ink-hairline);
      border-radius: var(--vh-radius-sm, 4px);
    }
    .vh-press-item figcaption {
      font-size: 13px;
      line-height: 1.6;
      color: var(--vh-ink-soft);
      margin-top: 10px;
    }
    .vh-press-item .vh-mono { font-size: 11px; color: var(--vh-ink-muted); }

    /* Persarchief. Genummerd omdat de volgorde de tijdlijn ís. */
    .vh-pers-lijst {
      list-style: none;
      margin: 0;
      padding: 0;
      max-width: 760px;
      border-top: 1px solid var(--vh-ink-hairline, rgba(28, 24, 19, 0.14));
    }
    .vh-pers-item {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 4px 20px;
      padding: 13px 0;
      border-bottom: 1px solid var(--vh-ink-hairline, rgba(28, 24, 19, 0.14));
    }
    .vh-pers-item a {
      font-size: 15.5px;
      line-height: 1.45;
      /* Ruimte laten voor de metaregel ernaast, maar op smal scherm mag de kop
         de volle breedte pakken en zakt de bron eronder. */
      flex: 1 1 22ch;
    }
    .vh-pers-meta {
      font-size: 11px;
      color: var(--vh-ink-muted);
      white-space: nowrap;
      flex: 0 0 auto;
    }
  </style>
</Base>

<script>import '../lib/cart';</script>
