---
export const prerender = true;

import LegalLayout from '../components/legal/LegalLayout.astro';
import { LEGAL_UPDATED } from '../lib/legal';
import { isPreviewHost } from '../lib/site';

/**
 * Cookiebeleid.
 *
 * De tekst volgt de werkelijke opstelling. Staat er geen `PUBLIC_GTM_ID`,
 * dan laadt Base.astro geen GTM en verschijnt er geen banner — en dan hoort
 * deze pagina dat ook te zeggen. Zodra de container er is, klapt de tekst om
 * naar de versie met toestemming.
 *
 * Zo kan het cookiebeleid niet uit de pas lopen met wat de site doet. Dat is
 * geen luxe: een cookiebeleid dat meer of minder claimt dan er gebeurt, is
 * precies waar een AVG-klacht op landt.
 *
 * Elke regel over localStorage is terug te vinden in de code: zie
 * src/lib/cart.ts, wishlist.ts, recent.ts, consent.ts, herkomst-client.ts en
 * de sleutels in de PDP en Het Atelier.
 *
 * NAGEMETEN 11 SEPTEMBER 2026, en zo meet je het opnieuw:
 * - Sleutelnamen: grep op `'vh_` in src/. De tabel noemde `vh_wishlist` en
 *   `vh_recent`, de code schreef `vh_wishlist_v1` en `vh_recent_v1`.
 * - Zonder toestemming: op de live site `document.cookie`, `localStorage` en
 *   `sessionStorage` na het laden van /shop, plus `curl -D -` op de pagina's
 *   voor HttpOnly-cookies. Uitkomst: niets.
 * - De cookies van Google: uit de GTM-container zelf (alleen `__googtag` en
 *   `__gaawe`, geen `AW-`-id) en uit Googles documentatie
 *   (support.google.com/analytics/answer/11397207): `_ga` en `_ga_<id>`,
 *   twee jaar. `_gcl_*` komt er pas bij als GA4 aan Google Ads gekoppeld is.
 *   GEBEURT DAT, DAN MOET DEZE PAGINA MEE, en de keuze opnieuw gevraagd
 *   worden (verhoog `CONSENT_KEY` in src/lib/consent.ts).
 * - `vh_reviews_<product>` staat bewust niet in de tabel: de productpagina
 *   schrijft hem alleen in de demostand zonder database, nooit op productie.
 */

const canonical = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
const meting = !isPreviewHost(canonical.origin) && !!import.meta.env.PUBLIC_GTM_ID;

const stored = [
  { key: 'vh_cart_v1', what: 'Wat er in je winkelmandje ligt', why: 'Anders is je mandje weg zodra je een andere pagina opent', how: 'Tot je het mandje leegt' },
  { key: 'vh_wishlist_v1', what: 'Je verlanglijst', why: 'Zodat je bewaarde stukken terugvindt', how: 'Tot je ze verwijdert' },
  { key: 'vh_recent_v1', what: 'Onlangs bekeken stukken', why: 'Voor de rail "onlangs bekeken" op de productpagina', how: 'Laatste 8 stuks' },
  { key: 'vh_checkout_form_v1', what: 'Je ingevulde bezorggegevens', why: 'Zodat een refresh of een afgebroken betaling je formulier niet wist', how: 'Tot je de browsertab sluit' },
  { key: 'vh_atelier_claim', what: 'Je geclaimde nummer in Het Atelier', why: 'Om je certificaat terug te kunnen tonen', how: 'Tot je het wist' },
  { key: 'vh_backinstock', what: 'Aangevraagde voorraadmeldingen', why: 'Alleen als de aanvraag niet bij ons aankwam, als vangnet', how: 'Tot je het wist' },
  ...(meting ? [
    { key: 'vh_consent_v1', what: 'Je cookiekeuze', why: 'Zodat we het niet elk bezoek opnieuw vragen', how: '12 maanden, daarna vragen we opnieuw' },
    { key: 'vh_ingang_v1', what: 'De pagina waarop je binnenkwam en de campagne in de link', why: 'Alleen met toestemming voor statistiek: om te zien welke campagne je bracht', how: 'Tot je de browsertab sluit' },
  ] : []),
];
---
<LegalLayout
  title="Cookiebeleid"
  heading="Cookies"
  headingAccent="en opslag"
  intro={meting
    ? 'Wat we plaatsen, waarvoor we toestemming vragen, en hoe je je keuze wijzigt.'
    : 'Waarom je hier geen cookiebanner ziet, en wat we wél lokaal in je browser bewaren.'}
  description="Cookiebeleid van Villa Happ: welke cookies we plaatsen, waarvoor we toestemming vragen en wat we lokaal in je browser bewaren."
  updated={LEGAL_UPDATED}
>
  {meting ? (
    <>
      <section>
        <h2>Waar we toestemming voor vragen</h2>
        <p>
          Bij je eerste bezoek verschijnt een keuzescherm. Tot je daar een keuze
          maakt, plaatsen we geen statistiek- of advertentiecookies en staan alle
          toestemmingssignalen richting Google op geweigerd. Weiger je, dan werkt
          de winkel volledig door: je kunt bestellen, betalen en retourneren zonder
          ergens toestemming voor te geven.
        </p>
        <p>
          Zolang je geen toestemming gaf, stuurt de site Google wel een melding
          zonder cookie dat er een pagina bekeken is. Daar zit geen herkenbaar
          kenmerk van jou in, en je bent er tussen twee bezoeken niet mee te
          herkennen. Google gebruikt die meldingen om het totale bezoek te
          schatten.
        </p>
        <div class="vh-legal-tablewrap">
          <table class="vh-legal-table">
            <thead><tr><th>Categorie</th><th>Waarvoor</th><th>Toestemming</th></tr></thead>
            <tbody>
              <tr>
                <td><b>Noodzakelijk</b></td>
                <td>Je mandje, je verlanglijst en je cookiekeuze. Zonder deze werkt de winkel niet.</td>
                <td>Niet nodig (art. 11.7a lid 3 Telecommunicatiewet)</td>
              </tr>
              <tr>
                <td><b>Statistieken</b></td>
                <td>
                  Google Analytics 4: welke pagina's worden bekeken en waar mensen
                  afhaken. Met deze toestemming onthouden we tijdens je bezoek ook de
                  pagina waarop je binnenkwam, zodat we zien welke campagne je bracht.
                </td>
                <td>Vooraf, per categorie</td>
              </tr>
              <tr>
                <td><b>Advertenties</b></td>
                <td>
                  We adverteren nog niet en er staat geen advertentietag op de site.
                  Geef je hiervoor toestemming, dan mag Google de gegevens uit de
                  statistiek ook gebruiken om advertenties af te stemmen. Beginnen we
                  met adverteren, dan passen we deze pagina aan en vragen we je keuze
                  opnieuw.
                </td>
                <td>Vooraf, per categorie</td>
              </tr>
            </tbody>
          </table>
        </div>
        <h3>Welke cookies dat zijn</h3>
        <p>
          Alleen als je toestemming geeft voor statistiek. Zonder die toestemming
          plaatsen we er geen enkele.
        </p>
        <div class="vh-legal-tablewrap">
          <table class="vh-legal-table">
            <thead><tr><th>Naam</th><th>Van</th><th>Waarvoor</th><th>Hoe lang</th></tr></thead>
            <tbody>
              <tr>
                <td><code>_ga</code></td>
                <td>Google Analytics</td>
                <td>Onderscheidt bezoekers van elkaar, zonder te weten wie je bent</td>
                <td>2 jaar</td>
              </tr>
              <tr>
                <td><code>_ga_KJH1QEH8HZ</code></td>
                <td>Google Analytics</td>
                <td>Houdt bij welk bezoek bij elkaar hoort</td>
                <td>2 jaar</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>
          Beheerders van de winkel krijgen bij het inloggen een sessiecookie
          (<code>vh_beheer</code>) die na twaalf uur verloopt. Bezoekers krijgen
          die nooit.
        </p>
        <p>
          De statistiektags worden geladen via Google Tag Manager.
          Wij sturen daarbij nooit je naam, e-mailadres, telefoonnummer of adres
          mee — ook niet bij een bestelling. Wat Google meekrijgt is welke pagina's
          je bekeek, wat er in je mandje lag en, bij een afgeronde bestelling, het
          bestelnummer en het bedrag.
        </p>
      </section>

      <section>
        <h2>Je keuze wijzigen</h2>
        <p>
          Dat kan op elk moment, en het intrekken van toestemming is net zo
          makkelijk als het geven ervan.
        </p>
        <p>
          <button type="button" class="vh-btn vh-btn--ghost" id="vh-cookies-heropen">
            <span>Cookievoorkeuren openen</span>
          </button>
        </p>
        <p style="margin-top:14px;">
          We vragen je keuze sowieso elke twaalf maanden opnieuw. Wis je je
          websitegegevens via je browser, dan verdwijnt de keuze ook en verschijnt
          het scherm bij je volgende bezoek.
        </p>
      </section>
    </>
  ) : (
    <section>
      <h2>Waarom er geen banner staat</h2>
      <p>
        Omdat er niets te vragen valt. We plaatsen geen trackingcookies, gebruiken
        geen advertentienetwerken en volgen je niet over websites heen. Voor
        opslag die strikt nodig is om de site te laten werken, is geen
        toestemming vereist. Een banner zou je dus alleen maar om iets vragen wat
        we niet doen.
      </p>
    </section>
  )}

  <section>
    <h2>Wat we lokaal bewaren</h2>
    <p>
      Een paar dingen slaan we op in je eigen browser, in de zogeheten
      localStorage of, als het alleen voor dit bezoek is, in de sessionStorage.
      Die gegevens blijven op jouw apparaat en worden niet naar ons of naar
      derden gestuurd, behalve wanneer je zelf een bestelling plaatst of een
      formulier verstuurt.
    </p>
    <div class="vh-legal-tablewrap">
      <table class="vh-legal-table">
        <thead><tr><th>Naam</th><th>Wat</th><th>Waarom</th><th>Hoe lang</th></tr></thead>
        <tbody>
          {stored.map((s) => (
            <tr>
              <td><code>{s.key}</code></td>
              <td>{s.what}</td>
              <td>{s.why}</td>
              <td>{s.how}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      Wil je dit wissen, dan kan dat via de instellingen van je browser
      (websitegegevens verwijderen). Je verliest dan je mandje en je
      verlanglijst; verder werkt de site gewoon.
    </p>
  </section>

  <section>
    <h2>Bezoekstatistiek zonder cookies</h2>
    <p>
      Los van het bovenstaande meten we bezoekersaantallen met Vercel Web
      Analytics. Die dienst werkt zonder cookies en zonder een herkenbare
      bezoekers-ID: er wordt geen profiel opgebouwd en je bent tussen twee
      bezoeken niet als dezelfde persoon te herkennen. We zien dus wel dát een
      pagina bezocht is, maar niet door wie. Daarvoor is geen toestemming nodig
      en die vragen we dus ook niet.
    </p>
  </section>

  <section>
    <h2>Betalen en adrescheck</h2>
    <p>
      Reken je af, dan ga je naar de betaalomgeving van Mollie. Wat Mollie daar
      plaatst valt onder hun eigen beleid. Vul je bij het afrekenen een
      Nederlandse postcode en huisnummer in, dan vraagt je browser rechtstreeks
      bij PDOK (Kadaster) de straat en plaats op; daar wordt geen cookie bij
      geplaatst. Meer daarover staat in onze
      <a href="/privacy">privacyverklaring</a>.
    </p>
  </section>

  <section>
    <h2>Wijzigingen</h2>
    <p>
      Verandert er iets aan wat we plaatsen, dan passen we deze pagina aan en
      vragen we je keuze opnieuw. De datum onderaan geeft aan wanneer dit beleid
      voor het laatst is bijgewerkt.
    </p>
  </section>
</LegalLayout>

{meting && (
  <script>
    import { onPageReady } from '../lib/page';
    onPageReady(() => {
      const btn = document.getElementById('vh-cookies-heropen');
      if (!btn) return;
      btn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('vh:consent-open'));
      });
    });
  </script>
)}
