---
export const prerender = true;

import Base from '../layouts/Base.astro';
import { BRAND, organizationLd } from '../lib/entity';

const siteOrigin = Astro.site?.origin || Astro.url.origin;

// AboutPage: dit is de entiteitspagina van het merk. De volledige
// Organization hangt eronder als mainEntity, zodat zoek- en AI-engines
// hier het complete, citeerbare beeld van Villa Happ ophalen.
const aboutLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Het verhaal van Villa Happ',
  url: `${siteOrigin}/story`,
  inLanguage: 'nl-NL',
  description: BRAND.definition,
  mainEntity: organizationLd(siteOrigin),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteOrigin}/` },
    { '@type': 'ListItem', position: 2, name: 'Het verhaal', item: `${siteOrigin}/story` },
  ],
};

/**
 * De hoofdstukken staan op de familiegeschiedenis zoals Rutger die heeft
 * aangeleverd. Eerder begon dit verhaal in 1960, wat vijftien jaar te laat
 * was: de eerste winkel opende op 10 mei 1945. Babyparadijs kwam er pas
 * midden jaren vijftig bij, ná de dood van Gaillard en de ontmoeting met
 * Noud van Happen.
 *
 * Gaillard en Noud zijn twee verschillende personen. Houd dat scherp: de
 * eerste winkel heette naar Gaillard, Babyparadijs kwam er met Noud.
 */
const chapters = [
  {
    breed: false,
    num: 'Hoofdstuk 01',
    year: '10 mei 1945',
    title: 'Noordstraat 85',
    img: '/img/heritage/1945-noordstraat-85-gaillard-kuijsters.webp',
    alt: 'De winkel Gaillard Kuijsters aan de Noordstraat 85 in Tilburg, met twee etalages vol kinderwagens, wiegjes en babygoed.',
    paras: [
      'Vijf dagen na de bevrijding openen Tony Kuijsters en haar partner Gaillard een winkel aan de Noordstraat 85 in Tilburg. De zaak heet Gaillard Kuijsters.',
      'Ze krijgen vier kinderen. Als de jongste twee maanden oud is, overlijdt Gaillard. Tony blijft achter met vier jonge kinderen en een winkel die nog moet groeien, en ze zet hem alleen voort. Ze houdt de deur elke ochtend open. Dat doorzettingsvermogen is het fundament van alles wat erna kwam.',
    ],
  },
  {
    breed: false,
    num: 'Hoofdstuk 02',
    year: 'Midden jaren vijftig',
    title: 'Babyparadijs',
    img: '/img/heritage/babyparadijs-heuvelstraat.webp',
    alt: 'Babyparadijs op de hoek van de Heuvelstraat in Tilburg, met de winkelpui en voorbijgangers op straat.',
    paras: [
      'Halverwege de jaren vijftig ontmoet Tony Noud van Happen. Samen openen ze een winkel in de Heuvelstraat in Tilburg, onder een nieuwe naam: Babyparadijs. Babykleding, kinderwagens en alles voor de kinderkamer.',
      'Tussen 1955 en 1961 krijgen Tony en Noud drie kinderen. De jongste is Rogér, geboren in 1961. Hij wordt later de vader van Rutger.',
      'Aan die winkel hangt een detail dat pas veel later betekenis kreeg. De babyuitzet voor Rutgers moeder werd er gekocht, door haar grootouders. Er waren op dat moment twee zwangere vrouwen in het spel, de een iets verder dan de ander: Tony, in verwachting van Rogér, en de vrouw die Rutgers moeder droeg. Zijn ouders scheelden die dag een paar meter, ruim twintig jaar voordat ze elkaar zouden ontmoeten.',
    ],
  },
  {
    breed: false,
    num: 'Hoofdstuk 03',
    year: 'Jaren zestig',
    title: 'De eerste die ging',
    img: null,
    alt: '',
    paras: [
      'In de jaren zestig lopen de inkoopprijzen op. Noud rekent uit dat het goedkoper kan als je zelf produceert, en reist met zijn laatste zakcenten naar het Verre Oosten om daar een eigen productielijn op te zetten. Hij is de eerste Europeaan die dat doet. Er is op dat moment niemand die hem kan vertellen hoe zoiets werkt.',
      'Het is een gok met alles wat hij heeft, en die pakt uit. Vanaf midden jaren zestig tot eind 2010 blijven de fabrieken in China en Bangladesh in handen van de familie Van Happen.',
    ],
  },
  {
    breed: false,
    num: 'Hoofdstuk 04',
    year: "Jaren '70, '80, '90",
    title: 'De marktleider die je niet zag',
    img: '/img/heritage/1980-industrieweg-74-76-waalwijk.webp',
    alt: 'Het bedrijfspand van Van Happen aan de Industrieweg in Waalwijk, met twee vrachtwagens op het terrein.',
    paras: [
      'Babyparadijs groeit uit tot de Van Happen Fashion Groep en wordt in de jaren tachtig marktleider in private label kinderkleding. Op de labels staan andere namen: Wibra, Zeeman, HEMA, V&D. Als er ruimte over was in de fabrieken, werden daar ook merken als Replay en Diesel geproduceerd. Veel mensen hebben kleding van deze familie gedragen zonder dat ooit te weten. Daarnaast draaien de eigen merken VHF en Artoni op volle toeren.',
      'Het bedrijf verhuist mee met zijn groei. Elzenweg 33 in Waalwijk in 1972, Industrieweg 74-76 in 1980, en in 1990 een nieuw hoofdkantoor aan de James Wattlaan 7 in Drunen.',
      'Op 12 juni 1986 komt de grootste order binnen die het bedrijf ooit kreeg: een paar miljoen rompertjes voor de Wibra. Diezelfde dag stond de moeder van Rutger voor haar eigen grootste opdracht. Rutger werd geboren.',
      'Halverwege de jaren negentig verandert de markt en verliest het bedrijf terrein. Het vakmanschap blijft.',
    ],
  },
  {
    breed: false,
    num: 'Hoofdstuk 05',
    year: '1999',
    title: 'Een eigen naam in de Koopgoot',
    img: '/img/heritage/villa-happ-winkel.webp',
    alt: 'Een Villa Happ winkel met het logo boven de etalages, kinderkleding in de vitrines en Arjo the Rat bij de ingang.',
    paras: [
      'In 1999 krijgt het familieverhaal een eigen merk: Villa Happ. De eerste winkel opent in de Beursgallery in de Rotterdamse Koopgoot, en het is Rutger die hem opent, dertien jaar oud. Hij is ook de eerste Arjo the Rat, de mascotte van het merk. Winkel nummer twee volgt in de Marikenstraat in Nijmegen.',
      'Het concept slaat aan. Op het hoogtepunt telt Villa Happ 80 winkels verspreid over Europa en meer dan 120 verkooppunten, de helft in eigen beheer en de helft franchise. Naast eigen labels als Rebble-Pebble, Hot-Gossip en Square Deal liggen er merken als Brunotti en Cars.',
      'Die groei wordt geleid vanuit het hoofdkantoor aan de James Wattlaan in Drunen. Pas in juni 2006 verhuist het kantoor naar Kasteel Zwijnsbergen in Helvoirt, een echt kasteel in Brabant. De ambities reiken dan verder dan Nederland: een internationaal kantoor in Dubai, plannen voor Düsseldorf, Athene en Istanboel.',
    ],
  },
  {
    breed: false,
    num: 'Hoofdstuk 06',
    year: '2004 tot 2010',
    title: 'The Comeback Kid',
    img: null,
    alt: '',
    paras: [
      'In 2004 wordt de keten verkocht aan een investeringsmaatschappij. Binnen een jaar gaat het mis. De familie koopt het bedrijf terug en maakt een doorstart, en in 2007 geeft de vakpers Villa Happ een bijnaam die blijft hangen: The Comeback Kid.',
      'In 2009 koopt Villa Happ alle franchisenemers uit. Die financiering wordt uiteindelijk te zwaar om te dragen. In 2010 ligt er een doorstart klaar: Kruidvat en Zeeman hebben belangstelling en de financiering is zo goed als rond. Op het laatste moment klapt het, omdat de merkrechten niet worden overgedragen. Villa Happ verdwijnt uit het straatbeeld.',
      'Noud heeft dat einde niet meegemaakt. Hij overleed op 15 november 2007, 78 jaar oud. Tony overleed op 26 november 2016, 95 jaar oud. Zij heeft de winkel aan de Noordstraat geopend en de laatste zien sluiten.',
    ],
  },
  {
    breed: true,
    num: 'Hoofdstuk 07',
    year: '2021 tot nu',
    title: 'De derde generatie',
    img: '/img/heritage/calle-artoni-85-25.webp',
    alt: 'Twee opnamen van dezelfde plek in Spanje, in elkaar overlopend: links Rogér van Happen bij het bord C. Artoni in februari 1985, rechts Rutger van Happen op dezelfde hoek in februari 2025.',
    paras: [
      'Tien jaar na de val worden de merkrechten niet verlengd. Ze vervallen, en Rutger van Happen, kleinzoon van Tony en Noud, haalt ze terug naar de familie. Jarenlang onderzoekt hij hoe de comeback eruit moet zien. De pandemie vertraagt de plannen.',
      'In Spanje ligt een straat die naar Noud & Tony is vernoemd. In februari 1985 stond Rogér daar op de foto. Veertig jaar later stond Rutger op dezelfde plek.',
      'In 2026 keert Villa Happ terug als lifestylelabel, voor de generatie die ermee opgroeide en de generatie daarna. Het merk begon in Tilburg en werkt vandaag vanuit Waalwijk. De eerste twee producten zijn een Back-Cap in een genummerde oplage van 500 stuks met certificaat, en sokken die Stap voor Stap heten. Want zo gaat dit verhaal verder. Stap voor stap.',
    ],
  },
];
---
<Base title="Het verhaal · Villa Happ" description={`${BRAND.age} jaar Villa Happ: van een winkel aan de Noordstraat in Tilburg tot The Comeback Kid. Twee keer gevallen, drie keer opgestaan.`}>

  <script type="application/ld+json" set:html={JSON.stringify(aboutLd)} is:inline></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} is:inline></script>

  <!-- Hero -->
  <header class="st-hero">
    <p class="st-hero-label vh-mono">Het verhaal · Sinds {BRAND.foundingYear}</p>
    <h1 class="st-hero-title">
      Twee keer gevallen.<br />
      <span class="vh-italic-accent st-accent">Drie keer</span> opgestaan.
    </h1>
    <p class="st-hero-sub">
      Van een winkel aan de Noordstraat in Tilburg tot 80 winkels door Europa,
      en terug. Dit is het echte verhaal van Villa Happ, verteld in zeven
      hoofdstukken. <span class="vh-heel">Ontstaan in Tilburg, vandaag thuis in Waalwijk.</span>
    </p>
    <span class="st-hero-cue vh-mono">Scroll</span>
  </header>

  <!-- Chapters -->
  <main class="st-main">
    {chapters.map((ch, i) => (
      <article class={`st-chapter${i % 2 === 1 ? ' st-chapter--flip' : ''}${ch.breed ? ' st-chapter--breed' : ''} st-reveal`}>
        <div class="st-chapter-text">
          <p class="st-chapter-num vh-mono">{ch.num}</p>
          <p class="st-chapter-year">{ch.year}</p>
          <h2 class="st-chapter-title">{ch.title}</h2>
          {ch.paras.map((p) => <p class="st-chapter-para">{p}</p>)}
        </div>
        <div class={`st-chapter-media${ch.img ? '' : ' is-placeholder'}`}>
          {ch.img
            ? <img
                src={ch.img}
                alt={ch.alt}
                width={ch.breed ? 1160 : 900}
                height={ch.breed ? 800 : 1125}
                loading="lazy"
                decoding="async"
              />
            : <span>{ch.year}</span>}
        </div>
      </article>
    ))}

    <!-- Pull quote -->
    <aside class="st-quote st-reveal">
      <p class="st-quote-text">De dragers van toen, zijn de <span class="vh-italic-accent st-accent">dragers</span> van nu.</p>
      <p class="st-quote-attr vh-mono">Villa Happ · Waalwijk, NL</p>
    </aside>

    <!-- CTA -->
    <section class="st-cta st-reveal">
      <h2 class="st-cta-title">Hoofdstuk drie is <span class="vh-italic-accent st-accent">begonnen</span>.</h2>
      <div class="st-cta-actions">
        <a href="/shop" class="vh-btn vh-btn--accent"><span>Shop de collectie</span>
          <svg class="vh-btn-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10m0 0L9 4m4 4L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/drops" class="vh-btn vh-btn--ghost"><span>Bekijk drops</span></a>
      </div>
    </section>
  </main>
</Base>

<style>
  .st-hero {
    min-height: 88vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 140px var(--vh-gutter) 80px;
    background: var(--vh-espresso);
    color: var(--vh-paper);
    position: relative;
  }
  .st-hero-label { color: var(--vh-accent); margin: 0 0 26px; }
  .st-hero-title {
    font-family: var(--vh-font-serif);
    font-size: clamp(44px, 7.5vw, 110px);
    line-height: 0.95;
    font-weight: 400;
    letter-spacing: -0.035em;
    margin: 0 0 28px;
  }
  .st-accent { color: var(--vh-accent); }
  .st-hero-sub {
    font-size: clamp(15px, 1.3vw, 18px);
    line-height: 1.6;
    color: rgba(244, 238, 227, 0.7);
    max-width: 520px;
    margin: 0;
  }
  .st-hero-cue {
    position: absolute;
    bottom: 28px; left: 50%;
    transform: translateX(-50%);
    color: rgba(244, 238, 227, 0.5);
    font-size: 10px;
    letter-spacing: 0.25em;
  }

  .st-main { background: var(--vh-paper); padding: clamp(70px, 10vw, 130px) var(--vh-gutter); }

  .st-chapter {
    display: grid;
    grid-template-columns: 6fr 5fr;
    gap: clamp(36px, 6vw, 90px);
    align-items: center;
    max-width: 1180px;
    margin: 0 auto clamp(80px, 12vw, 160px);
  }
  .st-chapter--flip .st-chapter-text { order: 2; }
  .st-chapter--flip .st-chapter-media { order: 1; }

  /**
   * Liggend beeld naast de tekst. De twee opnamen van Calle Artoni lopen in
   * elkaar over, Rogér links en Rutger rechts, en dat verdraagt de staande
   * 4/5-verhouding van de andere hoofdstukken niet: `object-fit: cover` snijdt
   * dan links en rechts weg en je houdt een strook over waarop je geen van
   * beiden meer herkent.
   *
   * Dus dezelfde tweekolomsopzet als de rest, maar met de mediakolom wat
   * ruimer en het beeld in zijn eigen verhouding.
   *
   * De verschuiving omlaag: het raster centreert op de hele tekstkolom, dus
   * inclusief het jaartal en de titel erboven. Bij een staand beeld valt dat
   * niet op, maar dit blok is een stuk lager en komt dan hoog naast de kop te
   * hangen. Deze nudge zet het midden op de alinea's in plaats van op de
   * kolom. Een transform en geen marge, zodat de hoogte van het hoofdstuk
   * niet verandert; de ruimte tussen hoofdstukken vangt het op.
   */
  .st-chapter--breed { grid-template-columns: 5fr 7fr; }
  .st-chapter--breed .st-chapter-media {
    aspect-ratio: 1160 / 800;
    transform: translateY(clamp(0px, 6vw, 78px));
  }
  /* Onder elkaar heeft die verschuiving geen betekenis meer. */
  @media (max-width: 860px) {
    .st-chapter--breed .st-chapter-media { transform: none; }
  }

  .st-chapter-num { color: var(--vh-ink-muted); margin: 0 0 14px; }
  .st-chapter-year {
    font-family: var(--vh-font-serif);
    font-style: italic;
    font-size: clamp(36px, 4.5vw, 64px);
    color: var(--vh-accent);
    line-height: 1;
    margin: 0 0 16px;
    letter-spacing: -0.02em;
  }
  .st-chapter-title {
    font-family: var(--vh-font-serif);
    font-size: clamp(26px, 3vw, 44px);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 22px;
  }
  .st-chapter-para {
    font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.75;
    color: var(--vh-ink-soft);
    margin: 0 0 16px;
    max-width: 54ch;
  }
  .st-chapter-para:first-of-type::first-letter {
    font-family: var(--vh-font-serif);
    font-style: italic;
    font-size: 2.6em;
    line-height: 0.8;
    float: left;
    padding: 6px 8px 0 0;
    color: var(--vh-accent);
  }

  .st-chapter-media {
    aspect-ratio: 4/5;
    border-radius: var(--vh-radius-md);
    overflow: hidden;
    background: var(--vh-paper-soft);
  }
  .st-chapter-media img { width: 100%; height: 100%; object-fit: cover; }
  .st-chapter-media.is-placeholder {
    display: flex; align-items: center; justify-content: center;
    font-family: var(--vh-font-serif);
    font-style: italic;
    font-size: clamp(34px, 4.5vw, 72px);
    color: var(--vh-ink-faint);
    text-align: center;
    padding: 20px;
  }

  .st-quote {
    background: var(--vh-espresso);
    color: var(--vh-paper);
    border-radius: var(--vh-radius-lg);
    max-width: 1180px;
    margin: 0 auto clamp(80px, 12vw, 160px);
    padding: clamp(56px, 9vw, 120px) clamp(28px, 6vw, 100px);
    text-align: center;
  }
  .st-quote-text {
    font-family: var(--vh-font-serif);
    font-size: clamp(28px, 4vw, 58px);
    line-height: 1.12;
    letter-spacing: -0.025em;
    margin: 0 0 26px;
  }
  .st-quote-attr { color: rgba(244, 238, 227, 0.5); margin: 0; }

  .st-cta { text-align: center; max-width: 760px; margin: 0 auto; }
  .st-cta-title {
    font-family: var(--vh-font-serif);
    font-size: clamp(32px, 4.5vw, 64px);
    font-weight: 400;
    letter-spacing: -0.03em;
    margin: 0 0 32px;
  }
  .st-cta-actions { display: inline-flex; gap: 12px; flex-wrap: wrap; justify-content: center; }

  /* Reveals */
  .st-reveal { opacity: 0; transform: translateY(30px); }
  .st-reveal.is-visible {
    opacity: 1; transform: translateY(0);
    transition: opacity 1s var(--vh-ease-out), transform 1s var(--vh-ease-out);
  }
  :global(.no-js) .st-reveal { opacity: 1; transform: none; }

  @media (max-width: 820px) {
    .st-chapter { grid-template-columns: 1fr; gap: 28px; }
    .st-chapter--flip .st-chapter-text { order: 1; }
    .st-chapter--flip .st-chapter-media { order: 2; }
    .st-chapter-media { max-height: 52vh; }
  }
  @media (prefers-reduced-motion: reduce) {
    .st-reveal { opacity: 1; transform: none; }
  }
</style>

<script>
  import '../lib/cart';
  import { onPageReady } from '../lib/page';

  onPageReady(() => {
    const els = document.querySelectorAll('.st-reveal');
    if (!els.length) return;
    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) { entry.target.classList.add('is-visible'); obs.unobserve(entry.target); }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
      els.forEach((el) => obs.observe(el));
    } else {
      els.forEach((el) => el.classList.add('is-visible'));
    }
  }); // einde onPageReady
</script>
