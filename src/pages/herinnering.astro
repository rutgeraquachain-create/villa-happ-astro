---
export const prerender = true;

import Base from '../layouts/Base.astro';
import { ACTIE, prijsInEuro, HERINNERING_MAX } from '../lib/herinnering';
import { MAX_ZIJDE, MAX_BYTES } from '../lib/herinnering-foto';
import '../styles/shop.css';

/**
 * De herinneringsactie.
 *
 * Dit is de pagina waar pers, social en de homepage naartoe linken. Hij vraagt
 * één ding van een bezoeker die het merk nog van vroeger kent: vertel wat je
 * ervan weet. Het adres dat hij daarbij achterlaat is het doel, de tegoedbon is
 * de reden.
 *
 * Let op de drie vinkjes onderaan het formulier. Geen ervan staat vooraf aan en
 * geen ervan is voorwaarde voor meedoen. Zie src/lib/herinnering.ts.
 */

const prijs = prijsInEuro();
const sluitTekst = '11 oktober 2026';

/**
 * De grenzen komen uit lib/herinnering-foto.ts, zodat de browser naar dezelfde
 * maat verkleint als waar de server op keurt. Twee losse getallen zouden na één
 * wijziging uit elkaar lopen, en dan keurt de server af wat de pagina zojuist
 * goedkeurde.
 */
const fotoGrenzen = { maxZijde: MAX_ZIJDE, maxBytes: MAX_BYTES };
---
<Base
  title="Wat is jouw Villa Happ herinnering? · Villa Happ"
  description={`Deel je herinnering aan Villa Happ en stuur een oude foto mee. De mooiste inzending wint een tegoedbon van ${prijs} voor de webshop.`}
>
  <section class="vh-page">
    <div class="vh-page-inner">

      <header class="vh-page-head">
        <p class="vh-page-label vh-mono">Sinds 1945 · Het archief</p>
        <h1 class="vh-page-title">Wat is jouw <span class="vh-italic-accent">herinnering</span>?</h1>
        <p class="vh-page-sub">
          Tachtig winkels door Europa, en een generatie die er in liep. Grote kans dat jij
          er kleren van droeg, of dat je moeder ze voor je kocht. We zijn op zoek naar die
          verhalen, en naar de foto's die erbij horen.
        </p>
      </header>

      <div class="vh-hh">

        <div class="vh-hh-uitleg">
          <h2>Hoe het werkt</h2>
          <ol class="vh-hh-stappen">
            <li>
              <b>Vertel je herinnering.</b>
              Een winkelbezoek, een jas die je jarenlang droeg, de speelhoek, de rat aan
              de muur. Hoe concreter, hoe leuker.
            </li>
            <li>
              <b>Voeg je foto toe.</b>
              Een scan of een kiekje van de oude foto is genoeg. Je kiest hem
              hiernaast en hij gaat meteen mee. Lukt dat niet, dan kun je hem later
              nog mailen naar <a href={`mailto:${ACTIE.fotoAdres}`}>{ACTIE.fotoAdres}</a>
              met je inzendnummer erbij.
            </li>
            <li>
              <b>Maak kans op {prijs}.</b>
              De mooiste inzending wint een tegoedbon van {prijs} voor de webshop.
              Inzenden kan tot en met {sluitTekst}, de winnaar horen we op 16 oktober.
            </li>
          </ol>
          <p class="vh-hh-klein">
            Meedoen is gratis en verplicht je tot niets. Lees de
            <a href="/actievoorwaarden">actievoorwaarden</a>.
          </p>
        </div>

        <form class="vh-form vh-hh-form" id="vh-hh-form" novalidate>
          <div class="vh-form-row">
            <div class="vh-field">
              <label for="hh-naam">Je naam</label>
              <input id="hh-naam" name="naam" autocomplete="name" required />
            </div>
            <div class="vh-field">
              <label for="hh-email">E-mailadres</label>
              <input id="hh-email" name="email" type="email" autocomplete="email" required />
            </div>
          </div>

          <div class="vh-field">
            <label for="hh-herinnering">Je herinnering</label>
            <textarea id="hh-herinnering" name="herinnering" rows="7" maxlength={HERINNERING_MAX} required></textarea>
            <p class="vh-hh-teller vh-mono" data-hh-teller aria-live="polite"></p>
          </div>

          <div class="vh-field">
            <label for="hh-foto">Je foto <span class="vh-hh-optioneel">optioneel, maar het maakt je inzending sterker</span></label>
            <input
              id="hh-foto"
              name="foto"
              type="file"
              accept="image/jpeg,image/png,image/webp"
              class="vh-hh-bestand"
            />
            <div class="vh-hh-voorbeeld" data-hh-voorbeeld hidden>
              <img alt="" data-hh-thumb />
              <div>
                <p class="vh-hh-bestandsnaam" data-hh-bestandsnaam></p>
                <button type="button" class="vh-hh-weg" data-hh-weg>Verwijderen</button>
              </div>
            </div>
            <p class="vh-hh-teller vh-mono" data-hh-fotomelding aria-live="polite"></p>
          </div>

          <!--
            Drie losse toestemmingen, alle drie uit. Nooit `checked` toevoegen:
            toestemming vraagt een actieve handeling (AVG art. 4 lid 11), en
            toestemming die aan meedoen vastzit is niet vrij gegeven (art. 7 lid 4).
          -->
          <fieldset class="vh-hh-akkoord">
            <legend>Nog even dit</legend>

            <div class="vh-check">
              <input id="hh-nieuwsbrief" name="nieuwsbrief" type="checkbox" value="1" />
              <label for="hh-nieuwsbrief">
                Houd me op de hoogte via de nieuwsbrief. Via die weg horen we het als eerste:
                nieuwe drops, acties en aanbiedingen.
              </label>
            </div>

            <div class="vh-check">
              <input id="hh-archief" name="magArchief" type="checkbox" value="1" />
              <label for="hh-archief">
                Villa Happ mag mijn foto gebruiken voor het archief op de website.
              </label>
            </div>

            <div class="vh-check">
              <input id="hh-naamgebruik" name="magNaam" type="checkbox" value="1" />
              <label for="hh-naamgebruik">
                Mijn naam mag daarbij vermeld worden.
              </label>
            </div>
          </fieldset>

          <!-- Honeypot: onzichtbaar voor mensen, ingevuld door bots -->
          <div class="vh-hp" aria-hidden="true">
            <label for="hh-bedrijf">Bedrijf (niet invullen)</label>
            <input id="hh-bedrijf" name="bedrijf" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <button type="submit" class="vh-btn vh-btn--accent" id="hh-verstuur">
            <span id="hh-verstuur-label">Stuur mijn herinnering in</span>
            <svg class="vh-btn-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0L9 4m4 4L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>

          <p class="vh-contact-error" id="hh-fout" role="alert"></p>
          <p class="vh-contact-note vh-mono">
            We bewaren je gegevens om de actie af te handelen. Zie de
            <a href="/privacy">privacyverklaring</a>.
          </p>
        </form>

        <div class="vh-hh-gelukt" id="hh-gelukt" hidden>
          <p class="vh-page-label vh-mono">Inzending binnen</p>
          <h2>Bedankt.</h2>
          <p>Je inzendnummer is:</p>
          <p class="vh-hh-nummer vh-mono" data-hh-nummer></p>

          <div data-hh-compleet hidden>
            <p>
              Je verhaal en je foto zijn allebei binnen. Je doet volledig mee en je
              hoeft verder niets te doen. We laten je weten wie er gewonnen heeft.
            </p>
          </div>

          <div data-hh-nogfoto>
            <p>
              Je hebt geen foto meegestuurd. Dat mag, maar een inzending met beeld
              maakt meer kans. Mail hem alsnog naar
              <a href={`mailto:${ACTIE.fotoAdres}`} data-hh-mailto>{ACTIE.fotoAdres}</a>
              met dit nummer in het onderwerp.
            </p>
          </div>

          <p class="vh-hh-klein" data-hh-mailstatus></p>
        </div>

      </div>
    </div>
  </section>
</Base>

<script define:vars={{ fotoGrenzen }}>
  window.__vhFotoGrenzen = fotoGrenzen;
</script>

<script>
  const form = document.getElementById('vh-hh-form') as HTMLFormElement | null;
  const gelukt = document.getElementById('hh-gelukt');
  const fout = document.getElementById('hh-fout');
  const knop = document.getElementById('hh-verstuur') as HTMLButtonElement | null;
  const knopLabel = document.getElementById('hh-verstuur-label');
  const veld = document.getElementById('hh-herinnering') as HTMLTextAreaElement | null;
  const teller = document.querySelector('[data-hh-teller]');

  // Teller onder het tekstvak. Niet als waarschuwing maar als aanmoediging:
  // een langer verhaal is een beter verhaal, en het vak oogt leeg.
  if (veld && teller) {
    const tel = () => {
      const n = veld.value.trim().length;
      teller.textContent = n === 0 ? '' : `${n} tekens`;
    };
    veld.addEventListener('input', tel);
    tel();
  }

  /* ---------- De foto ---------- */

  const grenzen = (window as any).__vhFotoGrenzen as { maxZijde: number; maxBytes: number };
  const fotoVeld = document.getElementById('hh-foto') as HTMLInputElement | null;
  const voorbeeld = document.querySelector('[data-hh-voorbeeld]') as HTMLElement | null;
  const thumb = document.querySelector('[data-hh-thumb]') as HTMLImageElement | null;
  const bestandsnaam = document.querySelector('[data-hh-bestandsnaam]');
  const fotomelding = document.querySelector('[data-hh-fotomelding]');
  const wegKnop = document.querySelector('[data-hh-weg]');

  /** Wat er straks verstuurd wordt. Null als er geen foto is of hij afviel. */
  let klaarZetteFoto: Blob | null = null;
  let klaarNaam = '';

  /**
   * Verkleinen in de browser.
   *
   * Een telefoonfoto van een oude kiek is al gauw acht megabyte, en een
   * serverless-verzoek op Vercel mag er maar viereneenhalf. Zonder deze stap
   * mislukt precies de inzending van iemand die zijn best deed met een goede
   * scan. Na het verkleinen komt er een paar honderd kilobyte binnen.
   *
   * Het resultaat is altijd JPEG. Dat zet meteen de iPhone-HEIC om, want de
   * canvas leest het en schrijft er iets uit dat elke browser en het
   * beheerscherm kunnen tonen.
   */
  function verklein(bestand: File): Promise<{ blob: Blob; naam: string }> {
    return new Promise((klaar, mislukt) => {
      const url = URL.createObjectURL(bestand);
      const beeld = new Image();
      beeld.onload = () => {
        URL.revokeObjectURL(url);
        const schaal = Math.min(1, grenzen.maxZijde / Math.max(beeld.width, beeld.height));
        const b = Math.round(beeld.width * schaal);
        const h = Math.round(beeld.height * schaal);
        const doek = document.createElement('canvas');
        doek.width = b;
        doek.height = h;
        const ctx = doek.getContext('2d');
        if (!ctx) return mislukt(new Error('geen canvas'));
        ctx.drawImage(beeld, 0, 0, b, h);
        doek.toBlob(
          (blob) => (blob ? klaar({ blob, naam: bestand.name.replace(/\.[^.]+$/, '') + '.jpg' }) : mislukt(new Error('geen blob'))),
          'image/jpeg',
          0.85,
        );
      };
      beeld.onerror = () => { URL.revokeObjectURL(url); mislukt(new Error('geen beeld')); };
      beeld.src = url;
    });
  }

  function wisFoto() {
    klaarZetteFoto = null;
    klaarNaam = '';
    if (fotoVeld) fotoVeld.value = '';
    if (voorbeeld) voorbeeld.hidden = true;
    if (thumb) thumb.removeAttribute('src');
    if (fotomelding) fotomelding.textContent = '';
  }

  wegKnop?.addEventListener('click', wisFoto);

  fotoVeld?.addEventListener('change', async () => {
    const bestand = fotoVeld.files?.[0];
    if (!bestand) return wisFoto();

    if (fotomelding) fotomelding.textContent = 'Even verkleinen…';
    try {
      const { blob, naam } = await verklein(bestand);
      if (blob.size > grenzen.maxBytes) {
        wisFoto();
        if (fotomelding) fotomelding.textContent = 'Deze foto blijft te groot. Probeer een kleinere.';
        return;
      }
      klaarZetteFoto = blob;
      klaarNaam = naam;
      if (thumb) thumb.src = URL.createObjectURL(blob);
      if (bestandsnaam) bestandsnaam.textContent = naam;
      if (voorbeeld) voorbeeld.hidden = false;
      if (fotomelding) fotomelding.textContent = `${Math.round(blob.size / 1024)} kB, klaar om mee te sturen`;
    } catch {
      // Kan de browser het beeld niet lezen (een kapot bestand, of een formaat
      // dat hij niet kent), dan is dat geen reden om de hele inzending te
      // blokkeren. Het verhaal telt ook zonder foto.
      wisFoto();
      if (fotomelding) fotomelding.textContent = 'Deze foto konden we niet lezen. Kies een JPG, PNG of WebP, of stuur hem later per mail.';
    }
  });

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (fout) fout.textContent = '';

      const fd = new FormData(form);

      // Honeypot: gevuld betekent bot. Doen alsof het gelukt is en niets
      // versturen, want een bot die een foutmelding krijgt probeert opnieuw.
      if (String(fd.get('bedrijf') || '').length > 0) {
        form.hidden = true;
        if (gelukt) gelukt.hidden = false;
        return;
      }

      if (knop) knop.disabled = true;
      if (knopLabel) knopLabel.textContent = 'Een moment…';

      try {
        /**
         * Multipart, en met de verkleinde versie in plaats van het bestand dat
         * de bezoeker koos. Het originele veld gaat er expres uit: dat draagt de
         * volle acht megabyte van een telefoonfoto en zou het verzoek laten
         * afkappen.
         */
        const verzending = new FormData();
        verzending.set('naam', String(fd.get('naam') || ''));
        verzending.set('email', String(fd.get('email') || ''));
        verzending.set('herinnering', String(fd.get('herinnering') || ''));
        // Een niet-aangevinkt vakje zit niet in de FormData, dus dit is exact
        // "heeft hij hem aangeklikt".
        if (fd.get('nieuwsbrief') === '1') verzending.set('nieuwsbrief', '1');
        if (fd.get('magArchief') === '1') verzending.set('magArchief', '1');
        if (fd.get('magNaam') === '1') verzending.set('magNaam', '1');
        if (klaarZetteFoto) verzending.set('foto', klaarZetteFoto, klaarNaam);

        // Geen Content-Type meezetten: de browser vult hem aan met de
        // boundary, en die zelf schrijven maakt de body onleesbaar.
        const res = await fetch('/api/herinnering', { method: 'POST', body: verzending });
        const data = await res.json();

        if (!res.ok || !data.success) {
          if (fout) fout.textContent = data.message || 'Er ging iets mis. Probeer opnieuw.';
          if (knop) knop.disabled = false;
          if (knopLabel) knopLabel.textContent = 'Stuur mijn herinnering in';
          return;
        }

        const nummerEl = document.querySelector('[data-hh-nummer]');
        if (nummerEl) nummerEl.textContent = data.nummer;

        // Het onderwerp vast invullen scheelt de deelnemer een handeling, en het
        // scheelt ons de inzendingen waarbij het nummer vergeten is.
        const mailto = document.querySelector('[data-hh-mailto]') as HTMLAnchorElement | null;
        if (mailto && data.nummer) {
          mailto.href = `mailto:${data.fotoAdres}?subject=${encodeURIComponent(`Foto bij inzending ${data.nummer}`)}`;
        }

        // Kwam de bevestigingsmail niet uit de wachtrij, dan is het nummer op
        // dit scherm het enige dat hij heeft. Dat hoort hij te weten.
        const status = document.querySelector('[data-hh-mailstatus]');
        if (status) {
          const regels: string[] = [];
          if (data.fotoMislukt) {
            regels.push('Je foto kwam er niet doorheen. Mail hem alsnog met dit nummer in het onderwerp.');
          }
          regels.push(data.mailVerstuurd
            ? 'Je krijgt dit nummer ook nog per mail.'
            : 'Let op: de bevestigingsmail is niet verstuurd. Noteer dit nummer even.');
          status.textContent = regels.join(' ');
        }

        // Wie zijn foto meestuurde is klaar en hoeft niets meer te mailen.
        const fotoBlok = document.querySelector('[data-hh-nogfoto]') as HTMLElement | null;
        const klaarBlok = document.querySelector('[data-hh-compleet]') as HTMLElement | null;
        if (data.fotoOntvangen && !data.fotoMislukt) {
          if (fotoBlok) fotoBlok.hidden = true;
          if (klaarBlok) klaarBlok.hidden = false;
        }

        form.hidden = true;
        if (gelukt) {
          gelukt.hidden = false;
          gelukt.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      } catch {
        if (fout) fout.textContent = 'Verbinding mislukt. Probeer opnieuw.';
        if (knop) knop.disabled = false;
        if (knopLabel) knopLabel.textContent = 'Stuur mijn herinnering in';
      }
    });
  }
</script>
