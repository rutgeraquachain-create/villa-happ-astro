---
export const prerender = true;

import Base from '../layouts/Base.astro';
import { BUSINESS } from '../lib/business';
import {
  RETURN_SENTENCE, DELIVERY_SENTENCE, VAT_SENTENCE, SHIPPING_SENTENCE,
  RETURN_FEE_SENTENCE, RETURN_SHIPPING_REFUND_SENTENCE,
  RETURN_SHIPPING_CORRECTION_SENTENCE, RETURN_CONDITION_SENTENCE,
  PAYMENT_SENTENCE,
} from '../lib/legal';
import '../styles/shop.css';

const groups = [
  {
    title: 'Bestellen & betalen',
    items: [
      { q: 'Welke betaalmethoden kan ik gebruiken?', a: PAYMENT_SENTENCE },
      { q: 'Is online betalen veilig?', a: 'Ja. Alle betalingen lopen versleuteld via Mollie. Wij slaan zelf geen betaalgegevens op.' },
      { q: 'Kan ik mijn bestelling nog wijzigen?', a: 'Zolang je bestelling nog niet is verzonden, passen we hem graag aan. Reageer zo snel mogelijk op je bevestigingsmail.' },
      { q: 'Zijn de prijzen inclusief btw?', a: `${VAT_SENTENCE} Verzendkosten zie je apart voordat je afrekent.` },
    ],
  },
  {
    title: 'Verzending',
    items: [
      { q: 'Wat kost verzending?', a: SHIPPING_SENTENCE },
      { q: 'Hoe snel is mijn bestelling in huis?', a: `${DELIVERY_SENTENCE} Je krijgt altijd een track en trace. Genoemde levertijden zijn een indicatie, geen garantie.` },
      { q: 'Naar welke landen versturen jullie?', a: 'Op dit moment bezorgen we in Nederland, België en Duitsland.' },
    ],
  },
  {
    title: 'Retour & ruilen',
    items: [
      { q: 'Kan ik mijn bestelling retourneren?', a: RETURN_SENTENCE },
      { q: 'Hoe retourneer ik?', a: `Meld je retour per e-mail of via het herroepingsformulier op de site. Je verstuurt het pakket zelf, op eigen kosten, naar ons retouradres in Waalwijk. Binnen ${BUSINESS.refundDays} dagen na je melding betalen we terug via dezelfde betaalmethode.` },
      { q: 'Wanneer betaal ik verwerkingskosten?', a: RETURN_FEE_SENTENCE },
      { q: 'Krijg ik de verzendkosten van mijn bestelling terug?', a: `${RETURN_SHIPPING_REFUND_SENTENCE} ${RETURN_SHIPPING_CORRECTION_SENTENCE}` },
      { q: 'Mag ik een stuk passen voordat ik het terugstuur?', a: RETURN_CONDITION_SENTENCE },
      { q: 'Kan ik een andere maat ruilen?', a: 'Retourneer het stuk en plaats een nieuwe bestelling in de juiste maat. Zo is de gewenste maat het snelst bij je.' },
    ],
  },
  {
    title: 'Product & maat',
    items: [
      { q: 'Hoe vallen de maten?', a: 'Onze stukken zijn unisex en vallen ruim. Twijfel je tussen twee maten, kies dan de kleinere. Op elke productpagina vind je een maatgids.' },
      { q: 'Is dit een origineel Villa Happ stuk?', a: 'Ja. Alles wordt in beperkte oplage gemaakt, zonder overproductie. De caps gaan een stap verder: die zijn genummerd en komen met een certificaat van echtheid.' },
      { q: 'Hoe onderhoud ik mijn stuk?', a: 'Was binnenstebuiten op 30 graden en laat aan de lucht drogen. Niet in de droger, dan gaan de kleur en pasvorm het langst mee.' },
    ],
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: groups.flatMap((g) => g.items).map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base title="Veelgestelde vragen · Villa Happ" description="Antwoorden op de meestgestelde vragen over bestellen, verzending, retourneren en de stukken van Villa Happ.">
  <section class="vh-page">
    <div class="vh-page-inner">
      <header class="vh-page-head">
        <p class="vh-page-label vh-mono">Hulp & service</p>
        <h1 class="vh-page-title">Veelgestelde <span class="vh-italic-accent">vragen</span></h1>
        <p class="vh-page-sub">Niet gevonden wat je zoekt? <a href="/contact">Neem contact op</a>, we helpen je graag verder.</p>
      </header>

      <div class="vh-trust">
        {groups.map((g) => (
          <div class="vh-trust-group">
            <h2 class="vh-trust-group-title">{g.title}</h2>
            {g.items.map((f) => (
              <details class="vh-acc">
                <summary>{f.q}</summary>
                <div class="vh-acc-body">{f.a}</div>
              </details>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline></script>
</Base>
