---
export const prerender = true;

import Base from '../../layouts/Base.astro';
import { levertijdIndicatie } from '../../lib/order-status';
import '../../styles/shop.css';

// Deze pagina is prerendered, dus het land is bij het bouwen onbekend. Beide
// varianten gaan mee als data-attribuut; het script kiest de juiste zodra de
// statusroute het bezorgland teruggeeft. Zo blijft order-status.ts de enige
// plek waar een levertermijn staat.
const levNL = levertijdIndicatie('NL');
const levEU = levertijdIndicatie('BE');
---
<Base
  title="Bedankt · Villa Happ"
  description="Bevestiging van je Villa Happ bestelling."
  noindex={true}
>
  <section class="vh-success">
    <div class="vh-success-inner">

      <!-- Kop en lead horen bij de staat, maar blijven één h1: vier h1's in
           de DOM (één per paneel) is rommelig voor validators en screenreaders. -->
      <div id="vh-success-head" aria-live="polite">
        <p class="vh-success-eyebrow vh-mono" id="vh-success-eyebrow">Even geduld</p>
        <h1 class="vh-success-title" id="vh-success-title">We controleren je <span class="vh-italic-accent">betaling</span>.</h1>
        <p class="vh-success-lead" id="vh-success-lead">Dit duurt meestal een paar seconden. Sluit dit venster nog niet.</p>
      </div>

      <!-- 1. Bezig met controleren (startstaat, geen extra inhoud) -->
      <div id="vh-state-checking"></div>

      <!-- 2. Betaald -->
      <div id="vh-state-paid" hidden>
        <div class="vh-success-seal" aria-hidden="true">
          <svg viewBox="0 0 120 120">
            <defs>
              <path id="vh-success-path" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0" />
            </defs>
            <text>
              <textPath href="#vh-success-path" startOffset="0">
                VILLA HAPP · BESTELLING BEVESTIGD · EST. 1945 ·&nbsp;
              </textPath>
            </text>
          </svg>
          <span class="vh-success-check">✓</span>
        </div>

        <div class="vh-success-card">
          <div class="vh-success-row"><span>Bestelnummer</span><b id="vh-ordernr">…</b></div>
          <div class="vh-success-row"><span>Verwachte bezorging</span><b id="vh-deliv" data-lev-nl={levNL} data-lev-eu={levEU}>…</b></div>
          <div class="vh-success-row"><span>Verzending</span><b>PostNL · met track &amp; trace</b></div>
        </div>

        <div class="vh-result-actions">
          <a href="/shop" class="vh-btn vh-btn--accent"><span>Verder shoppen</span>
            <svg class="vh-btn-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10m0 0L9 4m4 4L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="/" class="vh-btn vh-btn--ghost"><span>Naar home</span></a>
        </div>

        <p class="vh-success-foot vh-mono">Vragen over je bestelling? Reageer op de bevestigingsmail, we helpen je graag.</p>
      </div>

      <!-- 3. Betaling niet gelukt: mandje blijft bewust staan -->
      <div id="vh-state-failed" hidden>
        <div class="vh-result-actions">
          <a href="/checkout" class="vh-btn vh-btn--accent"><span>Opnieuw afrekenen</span></a>
          <a href="/cart" class="vh-btn vh-btn--ghost"><span>Naar je mandje</span></a>
        </div>
        <p class="vh-success-foot vh-mono">Blijft het misgaan? Mail ons, dan lossen we het samen op.</p>
      </div>

      <!-- 4. Nog in behandeling, of niet te controleren -->
      <div id="vh-state-pending" hidden>
        <div class="vh-success-card">
          <div class="vh-success-row"><span>Bestelnummer</span><b id="vh-ordernr-pending">…</b></div>
        </div>
        <div class="vh-result-actions">
          <button type="button" class="vh-btn vh-btn--ghost" id="vh-recheck"><span>Opnieuw controleren</span></button>
          <a href="/contact" class="vh-btn vh-btn--ghost"><span>Neem contact op</span></a>
        </div>
        <p class="vh-success-foot vh-mono">Reken niet nog een keer af: dat maakt een tweede bestelling aan.</p>
      </div>

    </div>
  </section>
</Base>

<script>
  import { clearCart } from '../../lib/cart';
  import { trackPurchase, type AnalyticsItem } from '../../lib/analytics';
  import { onPageReady } from '../../lib/page';

  onPageReady(() => {
  const checking = document.getElementById('vh-state-checking');
  if (!checking) return;

  const panels = {
    checking,
    paid: document.getElementById('vh-state-paid')!,
    failed: document.getElementById('vh-state-failed')!,
    pending: document.getElementById('vh-state-pending')!,
  };
  type PanelName = keyof typeof panels;

  // Kop en lead horen bij de staat; ze staan één keer in de DOM en worden
  // hier meegeschreven. aria-live meldt de wissel aan een screenreader.
  const HEAD: Record<PanelName, { eyebrow: string; title: string; lead: string }> = {
    checking: {
      eyebrow: 'Even geduld',
      title: 'We controleren je <span class="vh-italic-accent">betaling</span>.',
      lead: 'Dit duurt meestal een paar seconden. Sluit dit venster nog niet.',
    },
    paid: {
      eyebrow: 'Frame vastgelegd · Est. 1945 · Tilburg',
      title: 'Welkom in het <span class="vh-italic-accent">archief</span>.',
      lead: 'Bedankt voor je bestelling. Je hoort nu bij de mensen die dit merk weer tot leven brengen. De bevestiging ligt onderweg naar je mailbox.',
    },
    failed: {
      eyebrow: 'Betaling niet afgerond',
      title: 'Er is <span class="vh-italic-accent">niets afgeschreven</span>.',
      lead: 'De betaling is afgebroken of niet gelukt, dus je bestelling is niet geplaatst. Je mandje staat er nog precies zoals je het achterliet.',
    },
    pending: {
      eyebrow: 'In behandeling',
      title: 'Je betaling wordt <span class="vh-italic-accent">verwerkt</span>.',
      lead: 'Sommige betaalmethoden hebben even nodig. Zodra je bank het bevestigt, krijg je van ons een bevestigingsmail. Je hoeft niets te doen.',
    },
  };

  const eyebrowEl = document.getElementById('vh-success-eyebrow')!;
  const titleEl = document.getElementById('vh-success-title')!;
  const leadEl = document.getElementById('vh-success-lead')!;

  const show = (name: PanelName, leadOverride?: string) => {
    (Object.keys(panels) as PanelName[]).forEach((k) => {
      panels[k].toggleAttribute('hidden', k !== name);
    });
    const copy = HEAD[name];
    eyebrowEl.textContent = copy.eyebrow;
    titleEl.innerHTML = copy.title; // vaste opmaak, geen invoer van buiten
    leadEl.textContent = leadOverride || copy.lead;
  };

  // Meetgegevens uit het API-antwoord; gevuld zodra de status 'paid' is.
  let gemetenOrderNummer = '';
  let gemetenTotaal = 0;
  let gemetenVerzending = 0;
  let gemetenItems: AnalyticsItem[] = [];

  const params = new URLSearchParams(window.location.search);
  // Alleen het token: het bestelnummer komt uit het antwoord van de API, zodat
  // er geen oplopend nummer in de URL staat dat je kunt aftellen.
  const token = params.get('t') || '';
  const zetNummer = (nr: string) => {
    const label = nr ? `#${nr}` : 'Volgt per e-mail';
    document.getElementById('vh-ordernr')!.textContent = label;
    document.getElementById('vh-ordernr-pending')!.textContent = label;
  };
  zetNummer('');

  /* Bezorging als INDICATIE, nooit als kalenderdatum.
     Huisregel uit het Aqua Chain-portaal: een pagina of mail die niet live
     kan bijwerken belooft geen exacte dag. Deze pagina noemde er wel een,
     berekend uit werkdagen, zonder feestdagen en zonder weet van een
     vertraagde rit. Die datum werd daarmee een afspraak. */
  /* Stond hier als vaste tekst met de Nederlandse termijn, waardoor een
     Belgische of Duitse klant hier 3 werkdagen las terwijl zijn eigen
     klantportaal 5 zei. Beide varianten komen nu uit order-status.ts en
     staan als data-attribuut op het element; zodra de statusroute het
     bezorgland meldt, wordt de juiste gekozen. */
  function zetBezorging(land: string) {
    const el = document.getElementById('vh-deliv') as HTMLElement | null;
    if (!el) return;
    const eu = land === 'BE' || land === 'DE';
    // `dataset` geeft `string | undefined`; een lege string is hier de veilige
    // uitkomst, want een ontbrekend attribuut hoort geen "undefined" te tonen.
    el.textContent = (eu ? el.dataset.levEu : el.dataset.levNl) || '';
  }
  zetBezorging('NL');

  /**
   * Mollie stuurt de klant hierheen bij élke afloop — betaald, mislukt,
   * verlopen of afgebroken in de bankapp. Alleen bij een bevestigde
   * betaling zeggen we "bedankt" en legen we het mandje; in elk ander
   * geval blijft het mandje staan.
   *
   * De webhook en deze redirect zijn een race: vlak na het betalen staat
   * de order soms nog op 'open'. Daarom pollen we een halve minuut.
   */
  let timer: ReturnType<typeof setTimeout> | undefined;
  let tries = 0;
  const MAX_TRIES = 15; // 15 × 2s ≈ 30 seconden

  async function check() {
    if (!token) {
      // Zonder redirect-parameters valt er niets te verifiëren.
      // Dan niets beloven en niets weggooien.
      show('pending');
      return;
    }

    let state = 'unknown';
    try {
      const res = await fetch(`/api/checkout/status?t=${encodeURIComponent(token)}`);
      if (res.ok) {
        const json = await res.json();
        state = json.state || 'unknown';
        if (json.order_number) { zetNummer(json.order_number); gemetenOrderNummer = json.order_number; }
        if (json.land) zetBezorging(json.land);
        if (json.meting) {
          gemetenTotaal = json.meting.total_cents || 0;
          gemetenVerzending = json.meting.shipping_cents || 0;
          gemetenItems = (json.meting.items || []).map((i: any) => ({
            item_id: i.name,
            item_name: i.name,
            item_variant: i.variant,
            // De API geeft het regeltotaal; GA4 wil de stuksprijs.
            price_cents: i.quantity > 0 ? Math.round(i.total_cents / i.quantity) : i.total_cents,
            quantity: i.quantity,
          }));
        }
      }
    } catch { /* netwerkfout: hieronder afgehandeld als 'unknown' */ }

    if (state === 'paid') {
      clearCart(); // pas nu: de bestelling staat vast
      // Conversie pas hier, op de bevestigde betaling. Zou dit op paginaladen
      // vuren, dan telde elke afgebroken betaling als omzet — Mollie stuurt
      // de klant immers bij élke afloop hierheen. trackPurchase negeert een
      // leeg bestelnummer, dus een reload levert nooit een tweede aankoop.
      trackPurchase({
        orderNumber: gemetenOrderNummer,
        totalCents: gemetenTotaal,
        shippingCents: gemetenVerzending,
        items: gemetenItems,
      });
      show('paid');
      return;
    }
    if (state === 'failed') {
      show('failed'); // mandje bewust intact
      return;
    }

    // pending of unknown: nog even blijven proberen
    tries += 1;
    if (tries < MAX_TRIES) {
      timer = setTimeout(check, 2000);
      if (tries > 2) show('pending'); // na ~6s niet langer "even geduld"
      return;
    }
    show(
      'pending',
      'Je bank heeft de betaling nog niet bevestigd. Dat kan bij sommige methoden even duren. ' +
        'Je krijgt een mail zodra het rond is; is er niets afgeschreven, dan is de bestelling niet doorgegaan.',
    );
  }

  document.getElementById('vh-recheck')?.addEventListener('click', () => {
    tries = 0;
    show('checking');
    check();
  });

  check();

  return () => { if (timer) clearTimeout(timer); };
  }); // einde onPageReady
</script>
