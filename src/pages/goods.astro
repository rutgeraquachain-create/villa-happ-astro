---
export const prerender = true;

import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import { getCatalog } from '../lib/catalog';
import { formatPrice } from '../lib/commerce';
import '../styles/shop.css';

/**
 * Goods: alles wat Villa Happ verkoopt buiten de eigen kleding.
 *
 * Het begint met producten van VH_APProved-merken, merken die wij kiezen en
 * goedkeuren. Deze pagina zegt dat met zoveel woorden, want wie hier een fles
 * van VANN koopt, moet weten dat Villa Happ die niet zelf maakt. De tekst
 * belooft daarom niets over katoen, Waalwijk of vakmanschap: dat hoort bij
 * de kleding.
 *
 * De producten staan gewoon onder /shop/<slug>, net als de kleding. Eén
 * productpagina per product, dus één canonieke URL.
 */

const goods = (await getCatalog()).filter((p) => p.collectie === 'goods');
const siteOrigin = Astro.site?.origin || Astro.url.origin;
const merken = [...new Set(goods.map((p) => p.merk).filter(Boolean))] as string[];

const description =
  'Goods van Villa Happ: lifestyle producten van merken die wij kiezen en goedkeuren, zoals de drinkflessen van VANN. Besteld en verstuurd door Villa Happ.';

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${siteOrigin}/goods#collection`,
  url: `${siteOrigin}/goods`,
  name: 'Goods',
  description,
  inLanguage: 'nl-NL',
  isPartOf: { '@id': `${siteOrigin}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: goods.length,
    itemListElement: goods.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.name,
      url: `${siteOrigin}/shop/${p.slug}`,
    })),
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteOrigin}/` },
    { '@type': 'ListItem', position: 2, name: 'Goods', item: `${siteOrigin}/goods` },
  ],
};
---
<Base title="Goods · Lifestyle producten · Villa Happ" description={description}>
  <section class="vh-page">
    <div class="vh-page-inner">

      <header class="vh-page-head">
        <p class="vh-page-label vh-mono">Goods · VH_APProved</p>
        <h1 class="vh-page-title">Gekozen door <span class="vh-italic-accent">Villa Happ</span></h1>
        <p class="vh-page-sub">
          Naast onze eigen kleding verkopen we spullen van merken die we zelf goedkeuren.
          Je bestelt en betaalt bij ons, en wij versturen het ook.
        </p>
      </header>

      {goods.length > 0 ? (
        <div class="vh-listing">
          {goods.map((p, i) => (
            <a href={`/shop/${p.slug}`} class="vh-card">
              <div class="vh-card-media" transition:name={`product-${p.slug}`}>
                <span class="vh-card-num">{String(i + 1).padStart(2, '0')}</span>
                {p.merk && <span class="vh-card-badge">{p.merk}</span>}
                <Pic src={p.images[0]} alt={p.name} class="vh-card-img main" width={600} height={750} loading={i < 3 ? 'eager' : 'lazy'} />
                {p.images[1] && <Pic src={p.images[1]} alt="" class="vh-card-img alt" width={600} height={750} loading="lazy" aria-hidden="true" />}
                {p.variants.every((v) => v.stock === 0) && <span class="vh-stamp" aria-hidden="true">Uitverkocht</span>}
              </div>
              <div class="vh-card-info">
                <p class="vh-card-name">{p.name}</p>
                <p class="vh-card-price">{formatPrice(p.price_cents)}</p>
              </div>
              <p class="vh-card-meta vh-mono">{p.meta}</p>
            </a>
          ))}
        </div>
      ) : (
        <p class="vh-goods-leeg">De eerste Goods zijn onderweg.</p>
      )}

      <div class="vh-shop-intro">
        <h2>Wat VH_APProved betekent</h2>
        <p>
          Villa Happ maakt kleding die lang meegaat. Merken die op dezelfde manier
          werken, nemen we op onder de naam VH_APProved. We kiezen ze zelf, en we
          verkopen alleen wat we zouden gebruiken.
          {merken.length > 0 && <> Nu in Goods: {merken.join(', ')}.</>}
        </p>
        <p>
          Bestellen, betalen, verzenden en retourneren gaat bij Goods precies zoals
          bij de <a href="/shop">kleding</a>. Meer over de merken lees je op
          <a href="/brands"> VH_APProved</a>. Maak je zelf zoiets? Kijk dan bij
          <a href="/voor-merken"> voor merken</a>.
        </p>
      </div>

    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(collectionLd)} is:inline></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} is:inline></script>
</Base>
<script>import '../lib/cart';</script>

<style>
  .vh-goods-leeg { color: var(--vh-ink-soft); margin: 0 0 40px; }
</style>
