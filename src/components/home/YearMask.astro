<section class="vh-yearmask">
  <p class="vh-yearmask-label vh-mono">Anno</p>
  <h2
    class="vh-yearmask-text"
    data-yearmask
    style="background-image: url('/img/heritage/1945-noordstraat-85-gaillard-kuijsters.webp');"
  >1945</h2>
  <p class="vh-yearmask-cap">Gaillard Kuijsters aan de Noordstraat. Vier kinderen, één winkel, één moeder die doorging.</p>
