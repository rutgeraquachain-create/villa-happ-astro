---
// Uit het archief — sleepbare 35mm filmstrook met perforatie
import Pic from '../Pic.astro';
/**
 * De strook opent met het echte archief: de winkelpui van 1945, de twee
 * panden in Waalwijk, en Rutger als kindmodel in kleding uit de eigen
 * fabrieken. Daarna pas het huidige werk. Eerst het bewijs, dan de collectie.
 *
 * `alt` is per beeld ingevuld: dit zijn documentaire foto's, geen decoratie,
 * dus een lege alt zou hier informatie weghalen.
 */
const shots = [
  { img: '/img/heritage/rutger-model-bruin.webp', id: 'MODEL·BRUIN', alt: 'Rutger van Happen als kindmodel in een bruin-blauw trainingspak uit de eigen collectie.' },
  { img: '/img/heritage/rutger-model-spijkerkleding.webp', id: 'MODEL·DENIM', alt: 'Rutger van Happen als kindmodel in spijkerkleding met Looney Tunes-print.' },
  { img: '/img/heritage/arjo-the-rat.webp', id: 'ARJO THE RAT', alt: 'Arjo the Rat, de mascotte van Villa Happ, in tuinbroek met het merklogo.' },
  { img: '/img/heritage/villa-happ-winkel.webp', id: 'DE WINKEL', alt: 'Een Villa Happ winkel met het logo boven de etalages, kinderkleding in de vitrines en Arjo the Rat bij de ingang.' },
  { img: '/img/heritage/1945-noordstraat-85-gaillard-kuijsters.webp', id: 'NOORDSTRAAT·45', alt: 'De winkel Gaillard Kuijsters aan de Noordstraat 85 in Tilburg, 1945.' },
  { img: '/img/heritage/babyparadijs-heuvelstraat.webp', id: 'HEUVELSTRAAT', alt: 'Babyparadijs op de hoek van de Heuvelstraat in Tilburg, met de winkelpui en voorbijgangers op straat.' },
  { img: '/img/heritage/1972-elzenweg-33-waalwijk.webp', id: 'ELZENWEG·72', alt: 'Het bedrijfspand aan de Elzenweg 33 in Waalwijk met een vrachtwagen van Van Happen.' },
  { img: '/img/heritage/1980-industrieweg-74-76-waalwijk.webp', id: 'INDUSTRIEWEG·80', alt: 'Het bedrijfspand aan de Industrieweg 74-76 in Waalwijk met twee vrachtwagens van Van Happen.' },
  // Vader en zoon op dezelfde plek, veertig jaar ertussen. Naast elkaar
  // houden, want los van elkaar is het twee keer een straatnaambord.
  { img: '/img/heritage/1985-calle-artoni-roger.webp', id: 'ARTONI·85', alt: 'Rogér van Happen bij het straatnaambord Calle Artoni in Spanje, februari 1985. De straat is vernoemd naar zijn ouders Noud en Tony.' },
  { img: '/img/heritage/2025-calle-artoni-rutger.webp', id: 'ARTONI·25', alt: 'Rutger van Happen bij hetzelfde straatnaambord Calle Artoni, februari 2025, veertig jaar na de foto van zijn vader.' },
  { img: '/img/products/hoodie-grey-lifestyle-v2.webp', id: 'FW26·01', alt: 'Villa Happ Heritage Hoodie in het grijs, gedragen.' },
  { img: '/img/products/hoodie-logo-detail-v2.webp', id: 'DROP·001', alt: 'Detail van het geborduurde Villa Happ embleem op de hoodie.' },
];
---
<section class="vh-film-section">
  <div class="vh-film-header vh-reveal">
    <div>
      <p class="vh-film-label vh-mono">05 / Uit het archief</p>
      <h2 class="vh-film-title">Gedragen door <span class="vh-italic-accent">generaties</span></h2>
    </div>
    <p class="vh-film-hint vh-mono">Sleep de strook ↔</p>
  </div>

  <div class="vh-film" data-cursor="Drag">
    <div class="vh-film-track" data-film-track>
      {shots.map((s) => (
        <div class="vh-film-frame">
          <div class="vh-film-shot">
            <Pic src={s.img} alt={s.alt} width={400} height={500} widths={[320, 480, 640, 768]} sizes="(max-width: 700px) 240px, 400px" loading="lazy" draggable="false" />
            <span class="vh-film-id vh-mono">{s.id}</span>
          </div>
        </div>
      ))}
      {/* Tweede reeks is puur voor de naadloze lus; aria-hidden, dus lege alt. */}
      {shots.map((s) => (
        <div class="vh-film-frame" aria-hidden="true">
          <div class="vh-film-shot">
            <Pic src={s.img} alt="" width={400} height={500} widths={[320, 480, 640, 768]} sizes="(max-width: 700px) 240px, 400px" loading="lazy" draggable="false" />
            <span class="vh-film-id vh-mono">{s.id}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
