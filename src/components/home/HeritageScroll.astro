---
// Horizontale pinned timeline, het echte verhaal in zeven hoofdstukken.
// Volledige versie staat op /story.
import Pic from '../Pic.astro';
const steps = [
  {
    num: 'Hoofdstuk 01 · Het begin',
    year: '1945',
    title: 'Noordstraat 85',
    text: 'Het land is vijf dagen vrij als Tony Kuijsters en haar partner Gaillard hun winkel openen aan de Noordstraat. Vier kinderen later is Gaillard er niet meer; de jongste is twee maanden oud. Tony doet de volgende ochtend gewoon weer open. En de ochtend daarna ook.',
    img: '/img/heritage/1945-noordstraat-85-gaillard-kuijsters.webp',
    alt: 'De winkel Gaillard Kuijsters aan de Noordstraat 85 in Tilburg, met twee etalages vol kinderwagens, wiegjes en babygoed.',
  },
  {
    num: 'Hoofdstuk 02 · Babyparadijs',
    year: "Jaren '50",
    title: 'Een nieuwe naam in de Heuvelstraat',
    text: 'Jaren staat ze er alleen voor. Dan ontmoet ze Noud van Happen, en samen beginnen ze opnieuw, een paar straten verderop. De winkel krijgt een naam die je niet vergeet: Babyparadijs. Er komen nog drie kinderen bij, van wie Rogér de jongste is.',
    img: '/img/heritage/babyparadijs-heuvelstraat.webp',
    alt: 'Babyparadijs op de hoek van de Heuvelstraat in Tilburg, met de winkelpui en voorbijgangers op straat.',
  },
  {
    num: 'Hoofdstuk 03 · De gok',
    year: "Jaren '60",
    title: 'De eerste die ging',
    text: 'De inkoopprijzen blijven stijgen en Noud rekent uit dat het anders kan. Hij pakt zijn laatste zakcenten en vertrekt naar het Verre Oosten om er zelf te laten produceren. Niemand in Europa is hem voorgegaan, dus niemand kan hem vertellen hoe het moet. Die gok wordt het fundament onder alles.',
    img: null,
    alt: '',
  },
  {
    num: 'Hoofdstuk 04 · De stille jaren',
    year: "'80s",
    title: 'De marktleider die je niet zag',
    text: 'Dertig jaar lang kleedt deze familie half Nederland, zonder dat iemand het weet. Op de labels staan Wibra, Zeeman, HEMA en V&D. Grote kans dat jij het droeg, of je moeder. De grootste order ooit, miljoenen rompertjes, valt op 12 juni 1986. Diezelfde dag wordt Rutger geboren.',
    img: '/img/heritage/1980-industrieweg-74-76-waalwijk.webp',
    alt: 'Het bedrijfspand van Van Happen aan de Industrieweg in Waalwijk, met twee vrachtwagens op het terrein.',
  },
  {
    num: 'Hoofdstuk 05 · Het gezicht',
    year: '1999',
    title: 'Een eigen naam in de Koopgoot',
    text: 'Na decennia van andermans labels komt er eindelijk een eigen naam: Villa Happ. De eerste winkel opent in de Koopgoot, en het lint wordt doorgeknipt door een jongen van dertien. Diezelfde jongen kruipt daarna in het pak van Arjo the Rat. Er volgen tachtig winkels door Europa, geleid vanuit het hoofdkantoor aan de James Wattlaan in Drunen, met ambities tot Dubai aan toe.',
    img: '/img/heritage/villa-happ-winkel.webp',
    alt: 'Een Villa Happ winkel met het logo boven de etalages, kinderkleding in de vitrines en Arjo the Rat bij de ingang.',
  },
  {
    num: 'Hoofdstuk 06 · De val, twee keer',
    year: '2×',
    title: 'The Comeback Kid',
    text: 'Verkocht, gevallen, teruggekocht, weer opgebouwd. De vakpers geeft het merk in 2007 een bijnaam die blijft plakken. In 2010 ligt er opnieuw een doorstart klaar en is de financiering zo goed als rond, tot de merkrechten niet worden overgedragen. Daar houdt het op.',
    img: null,
    alt: '',
  },
  {
    num: 'Hoofdstuk 07 · Nu',
    year: '2026',
    title: 'De derde generatie',
    text: 'Tien jaar later vervallen die merkrechten alsnog, en Rutger haalt ze terug naar de familie. In Spanje ligt een straat die naar zijn opa en oma is vernoemd; zijn vader stond daar in 1985 op de foto, hij veertig jaar later op dezelfde plek. Hoofdstuk drie begint. Stap voor stap.',
    img: '/img/heritage/2025-calle-artoni-rutger.webp',
    alt: 'Rutger van Happen bij het straatnaambord Calle Artoni in Spanje, de straat die naar zijn grootouders Noud en Tony is vernoemd.',
  },
];
---
<section class="vh-heritage">
  <div class="vh-heritage-track">

    <!-- Intro panel -->
    <div class="vh-heritage-panel vh-heritage-panel--intro">
      <span class="vh-sticker vh-sticker--light" style="--rot: -7deg; top: 20%; right: 14%;">Est. 1945 ✦ Tilburg</span>
      <span class="vh-sticker vh-sticker--light" style="--rot: 4deg; bottom: 18%; left: 12%;">The Comeback Kid · 2007</span>
      <div>
        <p class="vh-heritage-intro-label vh-mono">02 / Het verhaal</p>
        <h2 class="vh-heritage-intro-title">Drie generaties, één <span class="vh-italic-accent">verhaal</span></h2>
        <p class="vh-heritage-intro-hint vh-mono"><span class="vh-show-desktop">Scroll om te ontdekken</span><span class="vh-show-mobile">Swipe door de hoofdstukken</span></p>
      </div>
    </div>

    <!-- Timeline panels -->
    {steps.map((step) => (
      <div class="vh-heritage-panel">
        <div class="vh-heritage-text-col">
          <p class="vh-heritage-step-num vh-mono">{step.num}</p>
          <p class="vh-heritage-year">{step.year}</p>
          <h3 class="vh-heritage-step-title">{step.title}</h3>
          <p class="vh-heritage-step-text">{step.text}</p>
        </div>
        <div class={`vh-heritage-media${step.img ? '' : ' vh-heritage-media--placeholder'}`}>
          {step.img
            ? <Pic src={step.img} alt={step.alt} width={800} height={600} widths={[480, 640, 768, 1080]} sizes="(max-width: 700px) 90vw, 45vw" loading="lazy" />
            : <span>{step.year}</span>
          }
        </div>
      </div>
    ))}

  </div>
  <div class="vh-heritage-progress"><span></span></div>
</section>
